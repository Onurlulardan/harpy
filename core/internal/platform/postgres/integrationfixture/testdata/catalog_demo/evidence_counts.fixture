SELECT
(SELECT count(*) FROM catalog_a.catalog_demo_provisions),
(SELECT count(*) FROM catalog_a.catalog_demo_handoffs),
(SELECT count(*) FROM catalog_a.forms_catalog_demo_runs),
(SELECT count(*) FROM catalog_a.forms_catalog_demo_rows),
(SELECT count(*) FROM catalog_a.forms_record_change_receipts),
(SELECT count(*) FROM catalog_a.forms_record_audit),
(SELECT count(*) FROM platform.outbox
 WHERE event_type IN ('forms.record.created','forms.record.updated')),
(SELECT count(*) FROM catalog_a.forms_record_change_receipts
 WHERE operation='create'),
(SELECT count(*) FROM catalog_a.forms_record_change_receipts
 WHERE operation='update'),
(SELECT count(*) FROM catalog_a.forms_catalog_demo_rows WHERE row_version=2),
(SELECT count(*) FROM catalog_a.forms_catalog_demo_rows WHERE row_version=1),
(SELECT provision.ready FROM catalog_a.catalog_demo_provisions AS provision),
(SELECT run.run_state='ready' FROM catalog_a.forms_catalog_demo_runs AS run),
(SELECT run.request_sha256=handoff.request_sha256
 FROM catalog_a.forms_catalog_demo_runs AS run
 JOIN catalog_a.catalog_demo_handoffs AS handoff
   ON handoff.provision_receipt_id=run.provision_receipt_id),
(SELECT run.readback_sha256=handoff.readback_sha256
 FROM catalog_a.forms_catalog_demo_runs AS run
 JOIN catalog_a.catalog_demo_handoffs AS handoff
   ON handoff.provision_receipt_id=run.provision_receipt_id),
(SELECT encode(run.readback_sha256,'hex')
 FROM catalog_a.forms_catalog_demo_runs AS run)
