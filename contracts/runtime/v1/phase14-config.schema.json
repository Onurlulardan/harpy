{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/runtime/v1/phase14-config.schema.json",
  "title": "Harpy Phase 14 Runtime Config Catalog Fragment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contract_version", "profiles", "variables"],
  "properties": {
    "version": {"const": 1},
    "contract_version": {"const": "phase14-runtime-profile-config.v1"},
    "profiles": {
      "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
      "items": {"$ref": "#/$defs/profile"}
    },
    "variables": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/variable"}
    }
  },
  "$defs": {
    "profile": {"enum": [
      "api", "worker", "operator_initialize", "operator_identity_reconcile",
      "operator_license_reconcile", "operator_post_restore_reactivation_observer",
      "tenant_migration_executor",
      "database_backup_executor", "database_restore"
    ]},
    "access": {"enum": [
      "value", "read_only", "read_once_cleanup", "create_only", "atomic_write", "read_write"
    ]},
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profiles", "kind", "sensitivity"],
      "properties": {
        "name": {"type": "string", "pattern": "^(?:DEPLOYMENT_MODE|HARPY_[A-Z0-9_]+)$"},
        "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/profile"}},
        "kind": {"enum": ["enum", "integer", "duration", "ratio", "listen_address", "url", "kms_key_id", "path", "secret", "boolean"]},
        "sensitivity": {"enum": ["public", "configuration", "secret"]},
        "access": {"$ref": "#/$defs/access"},
        "file_variant": {"type": "string", "pattern": "^HARPY_[A-Z0-9_]+_FILE$"},
        "semantic": {"enum": ["iam_hmac_keyring_v1"]},
        "key_purpose": {"enum": ["login_directory_v1"]},
        "minimum_bytes": {"type": "integer", "minimum": 1},
        "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "content_schema": {"enum": ["iam-hmac-keyring.schema.json"]},
        "profile_access": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/profile"},
          "additionalProperties": {"$ref": "#/$defs/access"}
        },
        "default": {"type": "string"},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "oneOf": [
        {"required": ["access"], "not": {"required": ["profile_access"]}},
        {"required": ["profile_access"], "not": {"required": ["access"]}}
      ]
    }
  }
}
