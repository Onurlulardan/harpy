{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/runtime/v1/release-manifest.schema.json",
  "title": "Harpy PostgreSQL Release Manifest v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "contract_version", "release_id", "issued_at", "expires_at", "database_name",
    "database_origin", "database_owner", "database_encoding", "database_locale_provider",
    "database_collation", "database_ctype", "data_checksums",
    "postgres_image_digest", "postgres_engine_version", "vector_extension_version",
    "runtime_generation", "minimum_database_generation", "migration_manifest_sha256",
    "extension_manifest_sha256", "roles_manifest_sha256", "privileges_manifest_sha256",
    "ownership_manifest_sha256",
    "bootstrap_authority_manifest_sha256", "bootstrap_operation_digest",
    "extension_operation_digest", "credential_cleanup_operation_digest",
    "cutover_authority_adoption_operation_digest",
    "catalog_package_set_sha256"
  ],
  "properties": {
    "contract_version": {"const": "postgres-release-manifest.v1"},
    "release_id": {"type": "string", "format": "uuid"},
    "issued_at": {"$ref": "signed-receipt-defs.schema.json#/$defs/utcTimestamp"},
    "expires_at": {"$ref": "signed-receipt-defs.schema.json#/$defs/utcTimestamp"},
    "database_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "database_origin": {"enum": ["fresh", "v1_adopted"]},
    "database_owner": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseOwner"},
    "database_encoding": {"const": "UTF8"},
    "database_locale_provider": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseLocaleProvider"},
    "database_collation": {"const": "en_US.utf8"},
    "database_ctype": {"const": "en_US.utf8"},
    "data_checksums": {"$ref": "signed-receipt-defs.schema.json#/$defs/dataChecksums"},
    "postgres_image_digest": {"const": "sha256:c8a919765f2ef63681329fa21021b830cd4d79d1165bdca730dd016014e4da84"},
    "postgres_engine_version": {"const": "18.4"},
    "vector_extension_version": {"const": "0.8.3"},
    "runtime_generation": {"type": "integer", "minimum": 1},
    "minimum_database_generation": {"type": "integer", "minimum": 1},
    "migration_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "extension_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "roles_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "privileges_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "ownership_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "bootstrap_authority_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "bootstrap_operation_digest": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "extension_operation_digest": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "credential_cleanup_operation_digest": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "cutover_authority_adoption_operation_digest": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
    "catalog_package_set_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"}
  }
}
