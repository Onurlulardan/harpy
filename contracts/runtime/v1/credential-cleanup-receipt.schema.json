{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/runtime/v1/credential-cleanup-receipt.schema.json",
  "title": "Harpy Privileged Credential Cleanup Receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "kind", "payload", "signature"],
  "properties": {
    "contract_version": {"const": "credential-cleanup-receipt.v1"},
    "kind": {"const": "credential_cleanup"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": [
        "run_id", "release_id", "issued_at", "release_manifest_sha256",
        "bootstrap_authority_manifest_sha256", "cleanup_operation_digest",
        "database_name", "database_origin", "database_system_identifier", "database_oid",
        "database_owner", "database_encoding", "database_locale_provider",
        "database_collation", "database_ctype", "data_checksums", "principals", "result"
      ],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "release_id": {"type": "string", "format": "uuid"},
        "issued_at": {"$ref": "signed-receipt-defs.schema.json#/$defs/utcTimestamp"},
        "release_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
        "bootstrap_authority_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
        "cleanup_operation_digest": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
        "database_name": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseName"},
        "database_origin": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseOrigin"},
        "database_system_identifier": {"$ref": "signed-receipt-defs.schema.json#/$defs/systemIdentifier"},
        "database_oid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "database_owner": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseOwner"},
        "database_encoding": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseEncoding"},
        "database_locale_provider": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseLocaleProvider"},
        "database_collation": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseCollation"},
        "database_ctype": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseCType"},
        "data_checksums": {"$ref": "signed-receipt-defs.schema.json#/$defs/dataChecksums"},
        "principals": {
          "type": "array", "minItems": 2, "maxItems": 2, "items": false,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/cleanedPrincipal"}, {"properties": {"name": {"const": "harpy_cluster_admin"}}}]},
            {"allOf": [{"$ref": "#/$defs/cleanedPrincipal"}, {"properties": {"name": {"const": "harpy_extension_admin"}}}]}
          ]
        },
        "result": {"const": "succeeded"}
      }
    },
    "signature": {"$ref": "signed-receipt-defs.schema.json#/$defs/signature"}
  },
  "$defs": {
    "cleanedPrincipal": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "lease_id", "cleaned_at", "can_login", "password_state", "active_sessions", "membership_count"],
      "properties": {
        "name": {"$ref": "signed-receipt-defs.schema.json#/$defs/roleName"},
        "lease_id": {"type": "string", "format": "uuid"},
        "cleaned_at": {"$ref": "signed-receipt-defs.schema.json#/$defs/utcTimestamp"},
        "can_login": {"const": false}, "password_state": {"type": "null"},
        "active_sessions": {"const": 0}, "membership_count": {"const": 0}
      }
    }
  }
}
