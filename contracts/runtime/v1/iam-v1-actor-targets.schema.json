{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/runtime/v1/iam-v1-actor-targets.schema.json",
  "title": "Harpy IAM V1 actor assertion target registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": {"const": 1},
    "targets": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["domain", "base_url", "server_name"],
        "properties": {
          "domain": {"enum": ["analytics", "billing", "catalog", "documents", "forms", "notifications", "work", "workflow"]},
          "base_url": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"},
          "server_name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"}
        }
      }
    }
  }
}
