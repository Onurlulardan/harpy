{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/runtime/v1/extension-receipt.schema.json",
  "title": "Harpy PostgreSQL Extension Receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "kind", "payload", "signature"],
  "properties": {
    "contract_version": {"const": "postgres-extension-receipt.v1"},
    "kind": {"const": "extension_admin"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": [
        "run_id", "release_id", "issued_at", "release_manifest_sha256",
        "bootstrap_authority_manifest_sha256", "credential_lease_id", "postgres_image_digest",
        "ownership_manifest_sha256", "database_name", "database_system_identifier",
        "database_oid", "server_version_num",
        "database_origin", "database_owner", "database_encoding",
        "database_locale_provider", "database_collation", "database_ctype", "data_checksums",
        "session_user", "current_user", "operation_digest", "result",
        "extension_manifest_sha256", "extensions"
      ],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "release_id": {"type": "string", "format": "uuid"},
        "issued_at": {"$ref": "signed-receipt-defs.schema.json#/$defs/utcTimestamp"},
        "release_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
        "bootstrap_authority_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
        "credential_lease_id": {"type": "string", "format": "uuid"},
        "ownership_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
        "postgres_image_digest": {"const": "sha256:c8a919765f2ef63681329fa21021b830cd4d79d1165bdca730dd016014e4da84"},
        "database_name": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseName"},
        "database_system_identifier": {"$ref": "signed-receipt-defs.schema.json#/$defs/systemIdentifier"},
        "database_oid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "server_version_num": {"const": 180004},
        "database_origin": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseOrigin"},
        "database_owner": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseOwner"},
        "database_encoding": {"const": "UTF8"},
        "database_locale_provider": {"$ref": "signed-receipt-defs.schema.json#/$defs/databaseLocaleProvider"},
        "database_collation": {"const": "en_US.utf8"},
        "database_ctype": {"const": "en_US.utf8"},
        "data_checksums": {"$ref": "signed-receipt-defs.schema.json#/$defs/dataChecksums"},
        "session_user": {"const": "harpy_extension_admin"},
        "current_user": {"const": "harpy_extension_admin"},
        "operation_digest": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
        "result": {"const": "succeeded"},
        "extension_manifest_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"},
        "extensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version", "schema", "owner", "control_file_sha256"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
              "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
              "schema": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
              "owner": {"$ref": "signed-receipt-defs.schema.json#/$defs/extensionOwner"},
              "control_file_sha256": {"$ref": "signed-receipt-defs.schema.json#/$defs/sha256"}
            }
          }
        }
      }
    },
    "signature": {"$ref": "signed-receipt-defs.schema.json#/$defs/signature"}
  }
}
