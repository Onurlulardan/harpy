{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/runtime/v1/analytics-dashboard-export-fcart-kek-keyring.schema.json",
  "title": "Harpy Analytics dashboard export FCART KEK keyring v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "current", "retained"],
  "properties": {
    "version": {"const": 1},
    "current": {"$ref": "#/$defs/key"},
    "retained": {
      "type": "array", "maxItems": 7, "uniqueItems": true,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "key"],
      "properties": {
        "kid": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "key": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$"}
      }
    }
  }
}
