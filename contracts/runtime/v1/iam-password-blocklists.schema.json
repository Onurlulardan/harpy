{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/runtime/v1/iam-password-blocklists.schema.json",
  "title": "Harpy IAM Password Blocklists v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "normalization", "digest", "common", "compromised"],
  "properties": {
    "version": {"const": 1},
    "normalization": {"const": "unicode_nfc_v1"},
    "digest": {"const": "sha256"},
    "common": {"$ref": "#/$defs/artifact"},
    "compromised": {"$ref": "#/$defs/artifact"}
  },
  "x-harpy-distinct-artifact-paths": true,
  "x-harpy-distinct-artifact-digests": true,
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "config.schema.json#/$defs/absolutePath",
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
