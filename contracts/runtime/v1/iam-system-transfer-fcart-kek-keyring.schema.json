{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.harpy.io/runtime/v1/iam-system-transfer-fcart-kek-keyring.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "current", "retained"],
  "properties": {
    "version": {"const": 1},
    "current": {"$ref": "#/$defs/key"},
    "retained": {"type": "array", "maxItems": 7, "items": {"$ref": "#/$defs/key"}}
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "key"],
      "properties": {
        "kid": {"type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
      }
    }
  }
}
