{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/finalizer-lease.schema.json",
  "type":"object","additionalProperties":false,
  "required":[
    "contract_version","lease_id","release_id","environment_id","operation_id","run_id",
    "issued_at","not_before","expires_at","max_duration_seconds","role_lease","target",
    "adoption_lease_sha256","cleanup_receipt_sha256","authority_adoption_receipt_sha256",
    "finalization_state_sha256",
    "tenant_requirement_catalog_sha256","tenant_requirement_count","finalization_procedure_oid",
    "finalization_procedure_signature","terminal_state","terminal_evidence_sha256"
  ],
  "properties":{
    "contract_version":{"const":"cutover-finalizer-lease.v1"},
    "lease_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "release_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "environment_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "operation_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "run_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "issued_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "not_before":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "expires_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "max_duration_seconds":{"const":120},
    "role_lease":{"$ref":"#/$defs/roleLease"},
    "target":{"$ref":"shared-defs.schema.json#/$defs/databaseIdentity"},
    "adoption_lease_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "cleanup_receipt_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "authority_adoption_receipt_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "finalization_state_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "tenant_requirement_catalog_sha256":{"oneOf":[{"$ref":"shared-defs.schema.json#/$defs/sha256"},{"type":"null"}]},
    "tenant_requirement_count":{"type":["integer","null"],"minimum":1,"maximum":10000},
    "finalization_procedure_oid":{"$ref":"shared-defs.schema.json#/$defs/oid"},
    "finalization_procedure_signature":{"const":"cutover_authority.finalize_operation_v1(uuid,uuid,uuid,text,bytea,text,bytea,text,bytea,text,bytea,text,bytea,text,text,bytea)"},
    "terminal_state":{"enum":["completed","failed","cancelled"]},
    "terminal_evidence_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
  },
  "allOf":[
    {"if":{"properties":{"terminal_state":{"const":"completed"}}},
     "then":{"properties":{"tenant_requirement_catalog_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},"tenant_requirement_count":{"type":"integer"}}},
     "else":{"properties":{"tenant_requirement_catalog_sha256":{"type":"null"},"tenant_requirement_count":{"type":"null"}}}}
  ],
  "$defs":{
    "roleLease":{
      "type":"object","additionalProperties":false,
      "required":["principal","login","replication","connection_limit","password_state"],
      "properties":{
        "principal":{"const":"harpy_cutover_finalizer"},
        "login":{"const":true},"replication":{"const":false},
        "connection_limit":{"const":1},"password_state":{"const":"leased_secret"}
      }
    }
  }
}
