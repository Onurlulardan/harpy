{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/cutover/v1/registry.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "groups"],
  "properties": {
    "contract_version": {"const": "cutover-registry.v1"},
    "groups": {
      "type": "array", "minItems": 9, "maxItems": 9, "items": false,
      "prefixItems": [
        {"$ref":"#/$defs/globalBilling"},
        {"$ref":"#/$defs/tenantIAMSystemResources"},
        {"$ref":"#/$defs/tenantBillingForms"},
        {"$ref":"#/$defs/tenantWorkflow"},
        {"$ref":"#/$defs/tenantAnalytics"},
        {"$ref":"#/$defs/tenantCatalog"},
        {"$ref":"#/$defs/tenantWork"},
        {"$ref":"#/$defs/tenantDocuments"},
        {"$ref":"#/$defs/tenantNotifications"}
      ]
    }
  },
  "$defs": {
    "group": {
      "type":"object", "additionalProperties":false,
      "required":["scope_kind","ordinal","group_id","members"],
      "properties": {
        "scope_kind":{"enum":["global","tenant"]},
        "ordinal":{"type":"integer","minimum":1},
        "group_id":{"pattern":"^[a-z][a-z0-9_]{0,62}$"},
        "members":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,
          "items":{"enum":["analytics","billing","catalog","documents","forms","iam","system_resource_layout","notifications","work","workflow"]}}
      }
    },
    "globalBilling":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"global"},"ordinal":{"const":1},"group_id":{"const":"billing"},"members":{"const":["billing"]}}}]},
    "tenantIAMSystemResources":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"tenant"},"ordinal":{"const":1},"group_id":{"const":"iam_system_resources"},"members":{"const":["iam","system_resource_layout"]}}}]},
    "tenantBillingForms":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"tenant"},"ordinal":{"const":2},"group_id":{"const":"billing_forms"},"members":{"const":["billing","forms"]}}}]},
    "tenantWorkflow":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"tenant"},"ordinal":{"const":3},"group_id":{"const":"workflow"},"members":{"const":["workflow"]}}}]},
    "tenantAnalytics":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"tenant"},"ordinal":{"const":4},"group_id":{"const":"analytics"},"members":{"const":["analytics"]}}}]},
    "tenantCatalog":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"tenant"},"ordinal":{"const":5},"group_id":{"const":"catalog"},"members":{"const":["catalog"]}}}]},
    "tenantWork":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"tenant"},"ordinal":{"const":6},"group_id":{"const":"work"},"members":{"const":["work"]}}}]},
    "tenantDocuments":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"tenant"},"ordinal":{"const":7},"group_id":{"const":"documents"},"members":{"const":["documents"]}}}]},
    "tenantNotifications":{"allOf":[{"$ref":"#/$defs/group"},{"properties":{"scope_kind":{"const":"tenant"},"ordinal":{"const":8},"group_id":{"const":"notifications"},"members":{"const":["notifications"]}}}]}
  }
}
