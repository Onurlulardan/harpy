{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/authority-adoption-operation.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contract_version","operation_id","release_id","environment_id","mode",
    "previous_catalog_generation","catalog_generation","pre_catalog_contract_sha256",
    "post_catalog_contract_sha256","previous_authority_receipt_sha256","upgrade_artifact_sha256",
    "issued_at","expires_at","target","migration_manifest_sha256",
    "bootstrap_authority_manifest_sha256","executor","executor_session_user","ownership_mode",
    "membership_policy","quiescence_policy","authority_owner_role","objects",
    "dependency_contract_sha256","dependencies"],
  "properties":{
    "contract_version":{"const":"cutover-authority-adoption-operation.v1"},
    "operation_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "release_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "environment_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "mode":{"enum":["initial_adoption","reaffirmation","catalog_upgrade"]},
    "previous_catalog_generation":{"type":"integer","minimum":0,"maximum":2147483647},
    "catalog_generation":{"type":"integer","minimum":1,"maximum":2147483647},
    "pre_catalog_contract_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "post_catalog_contract_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "previous_authority_receipt_sha256":{"oneOf":[{"$ref":"shared-defs.schema.json#/$defs/sha256"},{"type":"null"}]},
    "upgrade_artifact_sha256":{"oneOf":[{"$ref":"shared-defs.schema.json#/$defs/sha256"},{"type":"null"}]},
    "issued_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "expires_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "target":{"$ref":"shared-defs.schema.json#/$defs/databaseIdentity"},
    "migration_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "bootstrap_authority_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "executor":{"const":"external_root_provisioner"},
    "executor_session_user":{"allOf":[{"$ref":"shared-defs.schema.json#/$defs/sqlName"},{"not":{"pattern":"^harpy_"}}]},
    "ownership_mode":{"enum":["superuser_direct_per_object","superuser_set_local_role_append_only"]},
    "membership_policy":{"const":"always_zero"},
    "quiescence_policy":{"$ref":"#/$defs/quiescencePolicy"},
    "authority_owner_role":{"$ref":"#/$defs/authorityOwnerRole"},
    "objects":{"type":"array","minItems":20,"maxItems":256,"items":{"$ref":"#/$defs/object"}}
    ,"dependency_contract_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
    ,"dependencies":{"type":"array","minItems":19,"maxItems":19,"items":{"$ref":"#/$defs/dependency"}}
  },
  "oneOf":[
    {"properties":{"mode":{"const":"initial_adoption"},"previous_catalog_generation":{"const":0},
      "catalog_generation":{"const":1},"previous_authority_receipt_sha256":{"type":"null"},
      "upgrade_artifact_sha256":{"type":"null"},"ownership_mode":{"const":"superuser_direct_per_object"},
      "objects":{"minItems":20,"maxItems":20}}},
    {"properties":{"mode":{"const":"reaffirmation"},
      "previous_authority_receipt_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
      "upgrade_artifact_sha256":{"type":"null"},"ownership_mode":{"const":"superuser_direct_per_object"}}},
    {"properties":{"mode":{"const":"catalog_upgrade"},
      "previous_authority_receipt_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
      "upgrade_artifact_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
      "ownership_mode":{"const":"superuser_set_local_role_append_only"},
      "objects":{"minItems":21}}}
  ],
  "$defs":{
    "quiescencePolicy":{
      "type":"object","additionalProperties":false,
      "required":["roles","terminate_sessions","require_zero_remaining_sessions",
        "restore_before_commit","expected_pre_namespace_sha256","expected_post_namespace_sha256"],
      "properties":{
        "roles":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/quiescedRolePolicy"}},
        "terminate_sessions":{"const":true},
        "require_zero_remaining_sessions":{"const":true},
        "restore_before_commit":{"const":true},
        "expected_pre_namespace_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "expected_post_namespace_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
      }
    },
    "quiescedRolePolicy":{
      "type":"object","additionalProperties":false,
      "required":["principal","pre_state","temporary_state","post_state",
        "password_verifier_must_remain_unchanged"],
      "properties":{
        "principal":{"const":"harpy_migrator"},
        "pre_state":{"$ref":"authority-adoption-receipt.schema.json#/$defs/migratorAtRestState"},
        "temporary_state":{"$ref":"authority-adoption-receipt.schema.json#/$defs/migratorTemporaryState"},
        "post_state":{"$ref":"authority-adoption-receipt.schema.json#/$defs/migratorAtRestState"},
        "password_verifier_must_remain_unchanged":{"const":true}
      }
    },
    "authorityOwnerRole":{"$ref":"authority-adoption-receipt.schema.json#/$defs/authorityOwnerRole"},
    "object":{
      "type":"object","additionalProperties":false,
      "required":["kind","schema_name","object_name","identity_arguments","action",
        "introduced_generation","pre_adoption_owner","adopted_owner","pre_definition_sha256",
        "adopted_definition_sha256","pre_adoption_acl_sha256","adopted_acl_sha256"],
      "properties":{
        "kind":{"enum":["schema","table","function"]},
        "schema_name":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
        "object_name":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
        "identity_arguments":{"type":"string","maxLength":1024,"pattern":"^(?:[a-z][a-z0-9_]*(?:,[a-z][a-z0-9_]*)*)?$"},
        "action":{"enum":["adopt","retain","add"]},
        "introduced_generation":{"type":"integer","minimum":1,"maximum":2147483647},
        "pre_adoption_owner":{"enum":["harpy_owner","harpy_cutover_authority_owner"]},
        "adopted_owner":{"const":"harpy_cutover_authority_owner"},
        "pre_definition_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "adopted_definition_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "pre_adoption_acl_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "adopted_acl_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
      }
    },
    "dependency":{
      "type":"object","additionalProperties":false,
      "required":["kind","schema_name","object_name","identity_arguments","owner",
        "definition_sha256","acl_sha256"],
      "properties":{
        "kind":{"enum":["schema","table","function"]},
        "schema_name":{"const":"platform"},
        "object_name":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
        "identity_arguments":{"type":"string","maxLength":1024,"pattern":"^(?:[a-z][a-z0-9_]*(?:,[a-z][a-z0-9_]*)*)?$"},
        "owner":{"const":"harpy_owner"},
        "definition_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "acl_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
      }
    }
  }
}
