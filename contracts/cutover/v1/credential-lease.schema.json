{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/credential-lease.schema.json",
  "type":"object","additionalProperties":false,
  "required":[
    "contract_version","lease_id","release_id","environment_id","operation_id","run_id",
    "issued_at","not_before","expires_at","max_duration_seconds","scope_kind","scope_id",
    "group_id","domains","plan_sha256","transform_manifest_sha256","source","target",
    "publication_name","slot_name","source_connection_limit","target_connection_limit",
    "role_leases","relations"
  ],
  "properties":{
    "contract_version":{"const":"cutover-credential-lease.v1"},
    "lease_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "release_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "environment_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "operation_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "run_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "issued_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "not_before":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "expires_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "max_duration_seconds":{"const":900},
    "scope_kind":{"enum":["global","tenant"]},
    "scope_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "group_id":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
    "domains":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"$ref":"shared-defs.schema.json#/$defs/sqlName"}},
    "plan_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "transform_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "source":{"$ref":"shared-defs.schema.json#/$defs/databaseIdentity"},
    "target":{"$ref":"shared-defs.schema.json#/$defs/databaseIdentity"},
    "publication_name":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
    "slot_name":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
    "source_connection_limit":{"type":"integer","minimum":2,"maximum":32},
    "target_connection_limit":{"type":"integer","minimum":1,"maximum":32},
    "role_leases":{
      "type":"array","minItems":2,"maxItems":2,"items":false,
      "prefixItems":[
        {"$ref":"#/$defs/decoderLease"},{"$ref":"#/$defs/adopterLease"}
      ]
    },
    "relations":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"shared-defs.schema.json#/$defs/relationMapping"}}
  },
  "$defs":{
    "roleLease":{
      "type":"object","additionalProperties":false,
      "required":["principal","login","replication","connection_limit","password_state"],
      "properties":{
        "principal":{"enum":["harpy_cutover_decoder","harpy_adopter"]},
        "login":{"const":true},"replication":{"type":"boolean"},
        "connection_limit":{"type":"integer","minimum":1,"maximum":32},
        "password_state":{"const":"leased_secret"}
      }
    },
    "decoderLease":{"allOf":[{"$ref":"#/$defs/roleLease"},{"properties":{"principal":{"const":"harpy_cutover_decoder"},"replication":{"const":true}}}]},
    "adopterLease":{"allOf":[{"$ref":"#/$defs/roleLease"},{"properties":{"principal":{"const":"harpy_adopter"},"replication":{"const":false}}}]}
  }
}
