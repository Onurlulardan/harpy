{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/terminal-evidence.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contract_version","operation_id","run_id","lease_manifest_sha256","plan_sha256","transform_manifest_sha256","terminal_state"],
  "properties":{
    "contract_version":{"const":"cutover-terminal-evidence.v1"},
    "operation_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "run_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "lease_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "plan_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "transform_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "terminal_state":{"enum":["completed","failed","cancelled"]},
    "final_lsn":{"$ref":"#/$defs/lsn"},
    "initial_copy":{"$ref":"#/$defs/initialCopy"},
    "checkpoint_count":{"type":"integer","minimum":1,"maximum":10000},
    "checkpoints":{"type":"array","minItems":1,"maxItems":10000,"items":{"$ref":"#/$defs/checkpoint"}},
    "journal_transaction_count":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "applied_change_count":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "journal_coverage_root_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "outcome_code":{"type":"string","minLength":10,"maxLength":19,"pattern":"^[a-z][a-z_]*$"},
    "outcome_evidence_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
  },
  "oneOf":[
    {
      "properties":{"terminal_state":{"const":"completed"}},
      "required":["final_lsn","initial_copy","checkpoint_count","checkpoints","journal_transaction_count","applied_change_count","journal_coverage_root_sha256"],
      "not":{"anyOf":[{"required":["outcome_code"]},{"required":["outcome_evidence_sha256"]}]}
    },
    {
      "properties":{"terminal_state":{"const":"failed"},"outcome_code":{"enum":["source_failed","target_failed","verification_failed","lease_expired"]}},
      "required":["outcome_code","outcome_evidence_sha256"],
      "not":{"anyOf":[{"required":["final_lsn"]},{"required":["initial_copy"]},{"required":["checkpoint_count"]},{"required":["checkpoints"]},{"required":["journal_transaction_count"]},{"required":["applied_change_count"]},{"required":["journal_coverage_root_sha256"]}]}
    },
    {
      "properties":{"terminal_state":{"const":"cancelled"},"outcome_code":{"enum":["operator_cancelled","superseded"]}},
      "required":["outcome_code","outcome_evidence_sha256"],
      "not":{"anyOf":[{"required":["final_lsn"]},{"required":["initial_copy"]},{"required":["checkpoint_count"]},{"required":["checkpoints"]},{"required":["journal_transaction_count"]},{"required":["applied_change_count"]},{"required":["journal_coverage_root_sha256"]}]}
    }
  ],
  "$defs":{
    "lsn":{"type":"string","pattern":"^(?:0|[1-9A-F][0-9A-F]{0,7})/(?:0|[1-9A-F][0-9A-F]{0,7})$"},
    "initialCopy":{
      "type":"object","additionalProperties":false,
      "required":["manifest_sha256","snapshot_name","snapshot_lsn","relation_count","partition_count","row_count","root_sha256"],
      "properties":{
        "manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "snapshot_name":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
        "snapshot_lsn":{"$ref":"#/$defs/lsn"},
        "relation_count":{"type":"integer","minimum":1,"maximum":4096},
        "partition_count":{"type":"integer","minimum":1,"maximum":10000},
        "row_count":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "root_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
      }
    },
    "checkpoint":{
      "type":"object","additionalProperties":false,
      "required":["relation_ordinal","checkpoint_key","applied_lsn","applied_rows","batch_count","batch_root_sha256"],
      "properties":{
        "relation_ordinal":{"type":"integer","minimum":1,"maximum":4096},
        "checkpoint_key":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\x00-\\x1F\\x7F]+$"},
        "applied_lsn":{"$ref":"#/$defs/lsn"},
        "applied_rows":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "batch_count":{"type":"integer","minimum":1,"maximum":2147483647},
        "batch_root_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
      }
    }
  }
}
