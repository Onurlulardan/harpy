{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/authority-adoption-receipt.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contract_version","receipt_id","operation_id","release_id","environment_id","mode",
    "previous_catalog_generation","catalog_generation","pre_catalog_contract_sha256",
    "post_catalog_contract_sha256","previous_authority_receipt_sha256","upgrade_artifact_sha256",
    "previous_catalog_checkpoint",
    "target","operation_sha256","migration_manifest_sha256","release_manifest_sha256",
    "bootstrap_authority_manifest_sha256","adopted_at","result","executor_session_user",
    "executor_superuser","pre_adoption_membership_count","pre_adoption_owned_object_count",
    "authority_owner_membership_count","quiescence_evidence","authority_owner_role",
    "catalog_instance_sha256","objects","dependency_contract_sha256",
    "dependency_instance_sha256","dependencies"],
  "properties":{
    "contract_version":{"const":"cutover-authority-adoption-receipt.v1"},
    "receipt_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "operation_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "release_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "environment_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
    "mode":{"enum":["initial_adoption","reaffirmation","catalog_upgrade"]},
    "previous_catalog_generation":{"type":"integer","minimum":0,"maximum":2147483647},
    "catalog_generation":{"type":"integer","minimum":1,"maximum":2147483647},
    "pre_catalog_contract_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "post_catalog_contract_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "previous_authority_receipt_sha256":{"oneOf":[{"$ref":"shared-defs.schema.json#/$defs/sha256"},{"type":"null"}]},
    "upgrade_artifact_sha256":{"oneOf":[{"$ref":"shared-defs.schema.json#/$defs/sha256"},{"type":"null"}]},
    "previous_catalog_checkpoint":{"oneOf":[{"$ref":"#/$defs/catalogCheckpoint"},{"type":"null"}]},
    "target":{"$ref":"shared-defs.schema.json#/$defs/databaseIdentity"},
    "operation_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "migration_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "release_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "bootstrap_authority_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "adopted_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
    "result":{"const":"succeeded"},
    "executor_session_user":{"allOf":[{"$ref":"shared-defs.schema.json#/$defs/sqlName"},{"not":{"pattern":"^harpy_"}}]},
    "executor_superuser":{"const":true},
    "pre_adoption_membership_count":{"const":0},
    "pre_adoption_owned_object_count":{"type":"integer","minimum":0,"maximum":256},
    "authority_owner_membership_count":{"const":0},
    "quiescence_evidence":{"$ref":"#/$defs/quiescenceEvidence"},
    "authority_owner_role":{"$ref":"#/$defs/authorityOwnerRole"},
    "catalog_instance_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "objects":{"type":"array","minItems":20,"maxItems":256,"items":{"$ref":"#/$defs/object"}},
    "dependency_contract_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "dependency_instance_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
    "dependencies":{"type":"array","minItems":19,"maxItems":19,"items":{"$ref":"#/$defs/dependency"}}
  },
  "oneOf":[
    {"properties":{"mode":{"const":"initial_adoption"},"previous_catalog_generation":{"const":0},
      "catalog_generation":{"const":1},"previous_authority_receipt_sha256":{"type":"null"},
      "upgrade_artifact_sha256":{"type":"null"},"previous_catalog_checkpoint":{"type":"null"},
      "pre_adoption_owned_object_count":{"const":0},
      "objects":{"minItems":20,"maxItems":20}}},
    {"properties":{"mode":{"const":"reaffirmation"},
      "previous_authority_receipt_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
      "upgrade_artifact_sha256":{"type":"null"},"previous_catalog_checkpoint":{"$ref":"#/$defs/catalogCheckpoint"}}},
    {"properties":{"mode":{"const":"catalog_upgrade"},
      "previous_authority_receipt_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
      "upgrade_artifact_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
      "previous_catalog_checkpoint":{"$ref":"#/$defs/catalogCheckpoint"},
      "objects":{"minItems":21}}}
  ],
  "$defs":{
    "quiescenceEvidence":{
      "type":"object","additionalProperties":false,
      "required":["roles","observed_pre_namespace_sha256","observed_post_namespace_sha256",
        "restored_before_commit"],
      "properties":{
        "roles":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/quiescedRoleEvidence"}},
        "observed_pre_namespace_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "observed_post_namespace_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "restored_before_commit":{"const":true}
      }
    },
    "quiescedRoleEvidence":{
      "type":"object","additionalProperties":false,
      "required":["principal","observed_pre_state","observed_temporary_state",
        "observed_post_state","terminated_session_count","remaining_session_count",
        "password_verifier_unchanged"],
      "properties":{
        "principal":{"const":"harpy_migrator"},
        "observed_pre_state":{"$ref":"#/$defs/migratorAtRestState"},
        "observed_temporary_state":{"$ref":"#/$defs/migratorTemporaryState"},
        "observed_post_state":{"$ref":"#/$defs/migratorAtRestState"},
        "terminated_session_count":{"type":"integer","minimum":0,"maximum":1000000},
        "remaining_session_count":{"const":0},
        "password_verifier_unchanged":{"const":true}
      }
    },
    "migratorAtRestState":{
      "type":"object","additionalProperties":false,
      "required":["login","inherit","superuser","createdb","createrole","replication",
        "bypassrls","connection_limit","password_state","valid_until","membership_count"],
      "properties":{"login":{"const":true},"inherit":{"const":false},
        "superuser":{"const":false},"createdb":{"const":false},"createrole":{"const":false},
        "replication":{"const":false},"bypassrls":{"const":false},
        "connection_limit":{"const":-1},"password_state":{"enum":["null","scram_sha_256"]},
        "valid_until":{"const":"infinity"},"membership_count":{"const":1}}
    },
    "migratorTemporaryState":{
      "type":"object","additionalProperties":false,
      "required":["login","inherit","superuser","createdb","createrole","replication",
        "bypassrls","connection_limit","password_state","valid_until","membership_count"],
      "properties":{"login":{"const":false},"inherit":{"const":false},
        "superuser":{"const":false},"createdb":{"const":false},"createrole":{"const":false},
        "replication":{"const":false},"bypassrls":{"const":false},
        "connection_limit":{"const":0},"password_state":{"enum":["null","scram_sha_256"]},
        "valid_until":{"const":"infinity"},"membership_count":{"const":1}}
    },
    "catalogCheckpoint":{
      "type":"object","additionalProperties":false,
      "required":["receipt_sha256","receipt_id","environment_id","target","catalog_generation",
        "adopted_at","catalog_contract_sha256","catalog_instance_sha256","objects"],
      "properties":{
        "receipt_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "receipt_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "environment_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "target":{"$ref":"shared-defs.schema.json#/$defs/databaseIdentity"},
        "catalog_generation":{"type":"integer","minimum":1,"maximum":2147483647},
        "adopted_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
        "catalog_contract_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "catalog_instance_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "objects":{"type":"array","minItems":20,"maxItems":256,"items":{"$ref":"#/$defs/object"}}
      }
    },
    "authorityOwnerRole":{
      "type":"object","additionalProperties":false,
      "required":["login","inherit","superuser","createdb","createrole","replication","bypassrls",
        "connection_limit","password_state","valid_until","membership_count","owned_object_count"],
      "properties":{"login":{"const":false},"inherit":{"const":false},"superuser":{"const":false},
        "createdb":{"const":false},"createrole":{"const":false},"replication":{"const":false},
        "bypassrls":{"const":false},"connection_limit":{"const":-1},"password_state":{"const":"null"},
        "valid_until":{"const":"infinity"},"membership_count":{"const":0},
        "owned_object_count":{"type":"integer","minimum":20,"maximum":256}}
    },
    "object":{
      "type":"object","additionalProperties":false,
      "required":["kind","schema_name","object_name","identity_arguments","introduced_generation",
        "object_oid","owner","definition_sha256","acl_sha256"],
      "properties":{"kind":{"enum":["schema","table","function"]},
        "schema_name":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
        "object_name":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
        "identity_arguments":{"type":"string","maxLength":1024,"pattern":"^(?:[a-z][a-z0-9_]*(?:,[a-z][a-z0-9_]*)*)?$"},
        "introduced_generation":{"type":"integer","minimum":1,"maximum":2147483647},
        "object_oid":{"$ref":"shared-defs.schema.json#/$defs/oid"},
        "owner":{"const":"harpy_cutover_authority_owner"},
        "definition_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "acl_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}}
    },
    "dependency":{
      "type":"object","additionalProperties":false,
      "required":["kind","schema_name","object_name","identity_arguments","owner",
        "definition_sha256","acl_sha256","object_oid"],
      "properties":{
        "kind":{"enum":["schema","table","function"]},
        "schema_name":{"const":"platform"},
        "object_name":{"$ref":"shared-defs.schema.json#/$defs/sqlName"},
        "identity_arguments":{"type":"string","maxLength":1024,"pattern":"^(?:[a-z][a-z0-9_]*(?:,[a-z][a-z0-9_]*)*)?$"},
        "owner":{"const":"harpy_owner"},
        "definition_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "acl_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "object_oid":{"$ref":"shared-defs.schema.json#/$defs/oid"}
      }
    }
  }
}
