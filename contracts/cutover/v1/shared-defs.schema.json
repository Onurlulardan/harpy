{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/shared-defs.schema.json",
  "$defs":{
    "uuid":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "utcTimestamp":{"type":"string","format":"date-time","pattern":"(?:Z|\\+00:00)$"},
    "systemIdentifier":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
    "databaseName":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,62}$"},
    "sqlName":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,62}$"},
    "oid":{"type":"integer","minimum":1,"maximum":4294967295},
    "signature":{
      "type":"object","additionalProperties":false,
      "required":["algorithm","key_id","value"],
      "properties":{
        "algorithm":{"const":"Ed25519"},
        "key_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
        "value":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"}
      }
    },
    "databaseIdentity":{
      "type":"object","additionalProperties":false,
      "required":["database_name","database_origin","system_identifier","database_oid"],
      "properties":{
        "database_name":{"$ref":"#/$defs/databaseName"},
        "database_origin":{"enum":["fresh","v1_adopted"]},
        "system_identifier":{"$ref":"#/$defs/systemIdentifier"},
        "database_oid":{"$ref":"#/$defs/oid"}
      }
    },
    "relationIdentity":{
      "type":"object","additionalProperties":false,
      "required":["schema_oid","relation_oid","schema_name","relation_name"],
      "properties":{
        "schema_oid":{"$ref":"#/$defs/oid"},"relation_oid":{"$ref":"#/$defs/oid"},
        "schema_name":{"$ref":"#/$defs/sqlName"},"relation_name":{"$ref":"#/$defs/sqlName"}
      }
    },
    "columnMapping":{
      "type":"object","additionalProperties":false,
      "required":["ordinal","source_attnum","target_attnum","transform_id","primary_key"],
      "properties":{
        "ordinal":{"type":"integer","minimum":1,"maximum":2048},
        "source_attnum":{"type":"integer","minimum":1,"maximum":32767},
        "target_attnum":{"type":"integer","minimum":1,"maximum":32767},
        "transform_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},
        "primary_key":{"type":"boolean"}
      }
    },
    "relationMapping":{
      "type":"object","additionalProperties":false,
      "required":["ordinal","source","target","replica_identity","columns","procedure_contract_id","apply_procedure_oid","apply_procedure_signature","expected_checkpoint_keys"],
      "properties":{
        "ordinal":{"type":"integer","minimum":1,"maximum":4096},
        "source":{"$ref":"#/$defs/relationIdentity"},"target":{"$ref":"#/$defs/relationIdentity"},
        "replica_identity":{"enum":["primary_key","index"]},
        "columns":{"type":"array","minItems":1,"maxItems":2048,"items":{"$ref":"#/$defs/columnMapping"}},
        "procedure_contract_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},
        "apply_procedure_oid":{"$ref":"#/$defs/oid"},
        "apply_procedure_signature":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}\\(uuid,uuid,text,uuid,smallint,text,pg_lsn,pg_lsn,pg_lsn,xid8,integer,jsonb,text\\)$"},
        "expected_checkpoint_keys":{"type":"array","minItems":1,"maxItems":1024,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\x00-\\x1F\\x7F]+$"}}
      }
    }
  }
}
