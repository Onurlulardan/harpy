{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/change-batch.schema.json",
  "type":"object","additionalProperties":false,
  "x-harpy-maximum-canonical-bytes":8388608,
  "required":["contract_version","payload","batch_sha256"],
  "properties":{
    "contract_version":{"const":"cutover-change-batch.v1"},
    "payload":{"$ref":"#/$defs/payload"},
    "batch_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"}
  },
  "$defs":{
    "jsonObject":{"type":"object","minProperties":1},
    "lsn":{"type":"string","pattern":"^(?:0|[1-9A-F][0-9A-F]*)/[0-9A-F]{1,8}$"},
    "position":{
      "type":"object","additionalProperties":false,
      "required":["snapshot_name","snapshot_lsn","received_lsn","commit_lsn","final_lsn","source_xid","batch_ordinal"],
      "properties":{
        "snapshot_name":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\x00-\\x1F\\x7F]+$"},
        "snapshot_lsn":{"$ref":"#/$defs/lsn"},
        "received_lsn":{"$ref":"#/$defs/lsn"},
        "commit_lsn":{"$ref":"#/$defs/lsn"},
        "final_lsn":{"oneOf":[{"$ref":"#/$defs/lsn"},{"type":"null"}]},
        "source_xid":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
        "batch_ordinal":{"type":"integer","minimum":1,"maximum":2147483}
      }
    },
    "change":{
      "type":"object","additionalProperties":false,
      "required":["ordinal","kind","key","before","after"],
      "properties":{
        "ordinal":{"type":"integer","minimum":1,"maximum":1000},
        "kind":{"enum":["insert","update","delete"]},
        "key":{"$ref":"#/$defs/jsonObject"},
        "before":{"oneOf":[{"$ref":"#/$defs/jsonObject"},{"type":"null"}]},
        "after":{"oneOf":[{"$ref":"#/$defs/jsonObject"},{"type":"null"}]}
      },
      "allOf":[
        {"if":{"properties":{"kind":{"const":"insert"}}},"then":{"properties":{"before":{"type":"null"},"after":{"$ref":"#/$defs/jsonObject"}}}},
        {"if":{"properties":{"kind":{"const":"update"}}},"then":{"properties":{"before":{"$ref":"#/$defs/jsonObject"},"after":{"$ref":"#/$defs/jsonObject"}}}},
        {"if":{"properties":{"kind":{"const":"delete"}}},"then":{"properties":{"before":{"$ref":"#/$defs/jsonObject"},"after":{"type":"null"}}}}
      ]
    },
    "payload":{
      "type":"object","additionalProperties":false,
      "required":["operation_id","run_id","scope_kind","scope_id","relation_ordinal","checkpoint_key","checkpoint_state","source_position","last_key","changes"],
      "properties":{
        "operation_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "run_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "scope_kind":{"enum":["global","tenant"]},
        "scope_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "relation_ordinal":{"type":"integer","minimum":1,"maximum":4096},
        "checkpoint_key":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\x00-\\x1F\\x7F]+$"},
        "checkpoint_state":{"enum":["initial_copy","delta","complete"]},
        "source_position":{"$ref":"#/$defs/position"},
        "last_key":{"oneOf":[{"$ref":"#/$defs/jsonObject"},{"type":"null"}]},
        "changes":{"type":"array","minItems":0,"maxItems":1000,"items":{"$ref":"#/$defs/change"}}
      },
      "allOf":[
        {"if":{"properties":{"checkpoint_state":{"const":"complete"}}},"then":{"properties":{"source_position":{"properties":{"final_lsn":{"$ref":"#/$defs/lsn"}}}}},"else":{"properties":{"source_position":{"properties":{"final_lsn":{"type":"null"}}},"changes":{"minItems":1}}}}
      ]
    }
  }
}
