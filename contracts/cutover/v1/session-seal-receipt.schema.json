{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/session-seal-receipt.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contract_version","kind","payload","signature"],
  "properties":{
    "contract_version":{"const":"cutover-session-seal-receipt.v1"},
    "kind":{"const":"cutover_session_seal"},
    "payload":{
      "type":"object","additionalProperties":false,
      "required":[
        "receipt_id","lease_id","lease_manifest_sha256","environment_id","operation_id","run_id",
        "issued_at","source","target","credentials","source_sessions","target_sessions","result"
      ],
      "properties":{
        "receipt_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "lease_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "lease_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "environment_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "operation_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "run_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "issued_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
        "source":{"$ref":"shared-defs.schema.json#/$defs/databaseIdentity"},
        "target":{"$ref":"shared-defs.schema.json#/$defs/databaseIdentity"},
        "credentials":{"type":"array","minItems":2,"maxItems":2,"items":false,
          "prefixItems":[{"$ref":"#/$defs/decoderCredential"},{"$ref":"#/$defs/adopterCredential"}]},
        "source_sessions":{"type":"array","minItems":2,"maxItems":32,"items":{"$ref":"#/$defs/decoderSession"}},
        "target_sessions":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/adopterSession"}},
        "result":{"const":"sealed"}
      }
    },
    "signature":{"$ref":"shared-defs.schema.json#/$defs/signature"}
  },
  "$defs":{
    "credential":{
      "type":"object","additionalProperties":false,
      "required":["principal","can_login","password_state","replication","connection_limit"],
      "properties":{
        "principal":{"enum":["harpy_cutover_decoder","harpy_adopter"]},
        "can_login":{"const":false},"password_state":{"type":"null"},
        "replication":{"const":false},"connection_limit":{"const":0}
      }
    },
    "decoderCredential":{"allOf":[{"$ref":"#/$defs/credential"},{"properties":{"principal":{"const":"harpy_cutover_decoder"}}}]},
    "adopterCredential":{"allOf":[{"$ref":"#/$defs/credential"},{"properties":{"principal":{"const":"harpy_adopter"}}}]},
    "session":{
      "type":"object","additionalProperties":false,
      "required":["pid","backend_start","session_user","application_name"],
      "properties":{
        "pid":{"type":"integer","minimum":1},
        "backend_start":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
        "session_user":{"enum":["harpy_cutover_decoder","harpy_adopter"]},
        "application_name":{"type":"string","pattern":"^harpy-cutover/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
      }
    },
    "decoderSession":{"allOf":[{"$ref":"#/$defs/session"},{"properties":{"session_user":{"const":"harpy_cutover_decoder"}}}]},
    "adopterSession":{"allOf":[{"$ref":"#/$defs/session"},{"properties":{"session_user":{"const":"harpy_adopter"}}}]}
  }
}
