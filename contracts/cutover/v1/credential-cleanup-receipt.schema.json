{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/cutover/v1/credential-cleanup-receipt.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contract_version","kind","payload","signature"],
  "properties":{
    "contract_version":{"const":"cutover-credential-cleanup-receipt.v1"},
    "kind":{"const":"cutover_credential_cleanup"},
    "payload":{
      "type":"object","additionalProperties":false,
      "required":[
        "receipt_id","lease_id","lease_manifest_sha256","seal_receipt_sha256",
        "environment_id","operation_id","run_id","issued_at","principals","result"
      ],
      "properties":{
        "receipt_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "lease_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "lease_manifest_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "seal_receipt_sha256":{"$ref":"shared-defs.schema.json#/$defs/sha256"},
        "environment_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "operation_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "run_id":{"$ref":"shared-defs.schema.json#/$defs/uuid"},
        "issued_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
        "principals":{"type":"array","minItems":2,"maxItems":2,"items":false,
          "prefixItems":[{"$ref":"#/$defs/decoderCleanup"},{"$ref":"#/$defs/adopterCleanup"}]},
        "result":{"const":"succeeded"}
      }
    },
    "signature":{"$ref":"shared-defs.schema.json#/$defs/signature"}
  },
  "$defs":{
    "cleanup":{
      "type":"object","additionalProperties":false,
      "required":[
        "principal","cleaned_at","can_login","password_state","replication",
        "connection_limit","active_sessions","membership_count","dynamic_grants_revoked"
      ],
      "properties":{
        "principal":{"enum":["harpy_cutover_decoder","harpy_adopter"]},
        "cleaned_at":{"$ref":"shared-defs.schema.json#/$defs/utcTimestamp"},
        "can_login":{"const":false},"password_state":{"type":"null"},
        "replication":{"const":false},"connection_limit":{"const":0},
        "active_sessions":{"const":0},"membership_count":{"const":0},
        "dynamic_grants_revoked":{"const":true}
      }
    },
    "decoderCleanup":{"allOf":[{"$ref":"#/$defs/cleanup"},{"properties":{"principal":{"const":"harpy_cutover_decoder"}}}]},
    "adopterCleanup":{"allOf":[{"$ref":"#/$defs/cleanup"},{"properties":{"principal":{"const":"harpy_adopter"}}}]}
  }
}
