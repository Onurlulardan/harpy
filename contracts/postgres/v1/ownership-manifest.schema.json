{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/postgres/v1/ownership-manifest.schema.json",
  "title": "Harpy PostgreSQL Ownership Manifest v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "contract_version", "manifest_id", "database_origin", "database_name",
    "ownership_executor", "format", "object_count"
  ],
  "properties": {
    "contract_version": {"const": "postgres-ownership-manifest.v1"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "database_origin": {
      "$ref": "postgres-artifact-defs.schema.json#/$defs/databaseOrigin"
    },
    "database_name": {"$ref": "postgres-artifact-defs.schema.json#/$defs/databaseName"},
    "ownership_executor": {
      "enum": ["cluster_bootstrap", "external_root_provisioner"]
    },
    "format": {"enum": ["inline", "chunked"]},
    "object_count": {"$ref": "postgres-artifact-defs.schema.json#/$defs/safeInteger"},
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "postgres-artifact-defs.schema.json#/$defs/ownershipObject"}
    },
    "chunks": {
      "type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true,
      "items": {"$ref": "#/$defs/chunkDescriptor"}
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {"format": {"const": "inline"}},
          "required": ["objects"], "not": {"required": ["chunks"]}
        },
        {
          "properties": {"format": {"const": "chunked"}},
          "required": ["chunks"], "not": {"required": ["objects"]}
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "database_origin": {"const": "fresh"},
            "ownership_executor": {"const": "cluster_bootstrap"}
          }
        },
        {
          "properties": {
            "database_origin": {"const": "v1_adopted"},
            "ownership_executor": {"const": "external_root_provisioner"}
          }
        }
      ]
    }
  ],
  "$defs": {
    "chunkDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "count", "length_bytes", "sha256", "path"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 511},
        "count": {"type": "integer", "minimum": 1, "maximum": 512},
        "length_bytes": {"type": "integer", "minimum": 2, "maximum": 4194304},
        "sha256": {"$ref": "postgres-artifact-defs.schema.json#/$defs/sha256"},
        "path": {"$ref": "postgres-artifact-defs.schema.json#/$defs/artifactPath"}
      }
    }
  }
}
