{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/postgres/v1/credential-cleanup-operation.schema.json",
  "title": "Harpy PostgreSQL Credential Cleanup Operation v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "contract_version", "database_origin", "database_name", "input_hashes",
    "privileged_roles", "steps"
  ],
  "properties": {
    "contract_version": {"const": "credential-cleanup-operation.v1"},
    "database_origin": {
      "$ref": "postgres-artifact-defs.schema.json#/$defs/databaseOrigin"
    },
    "database_name": {"$ref": "postgres-artifact-defs.schema.json#/$defs/databaseName"},
    "input_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["roles_manifest_sha256", "privileges_manifest_sha256"],
      "properties": {
        "roles_manifest_sha256": {
          "$ref": "postgres-artifact-defs.schema.json#/$defs/sha256"
        },
        "privileges_manifest_sha256": {
          "$ref": "postgres-artifact-defs.schema.json#/$defs/sha256"
        }
      }
    },
    "privileged_roles": {
      "type": "array", "minItems": 2, "maxItems": 2, "items": false,
      "prefixItems": [
        {"const": "harpy_cluster_admin"},
        {"const": "harpy_extension_admin"}
      ]
    },
    "steps": {
      "type": "array", "minItems": 8, "maxItems": 8, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/verifyArtifacts"}, {"$ref": "#/$defs/disableLogin"},
        {"$ref": "#/$defs/clearPassword"}, {"$ref": "#/$defs/terminateSessions"},
        {"$ref": "#/$defs/removeMemberships"},
        {"$ref": "#/$defs/verifyCatalog"}, {"$ref": "#/$defs/revokeCredentials"},
        {"$ref": "#/$defs/publishReceipt"}
      ]
    }
  },
  "$defs": {
    "verifyArtifacts": {"$ref": "#/$defs/readStep", "properties": {
      "step_id": {"const": "verify_artifact_hashes"}
    }},
    "disableLogin": {"$ref": "#/$defs/externalStep", "properties": {
      "step_id": {"const": "disable_privileged_login"}
    }},
    "clearPassword": {"$ref": "#/$defs/externalStep", "properties": {
      "step_id": {"const": "clear_privileged_password"}
    }},
    "terminateSessions": {"$ref": "#/$defs/externalStep", "properties": {
      "step_id": {"const": "terminate_privileged_sessions"}
    }},
    "removeMemberships": {"$ref": "#/$defs/externalStep", "properties": {
      "step_id": {"const": "remove_privileged_memberships"}
    }},
    "verifyCatalog": {"$ref": "#/$defs/externalStep", "properties": {
      "step_id": {"const": "verify_final_role_catalog"}
    }},
    "revokeCredentials": {"$ref": "#/$defs/externalStep", "properties": {
      "step_id": {"const": "revoke_mounted_credentials"}
    }},
    "publishReceipt": {"$ref": "#/$defs/receiptStep", "properties": {
      "step_id": {"const": "publish_cleanup_receipt"}
    }},
    "readStep": {"$ref": "postgres-operation-defs.schema.json#/$defs/operationStep",
      "properties": {"transaction_class": {"const": "read_only_preflight"}}},
    "externalStep": {"$ref": "postgres-operation-defs.schema.json#/$defs/operationStep",
      "properties": {"transaction_class": {"const": "external_provisioner"}}},
    "receiptStep": {"$ref": "postgres-operation-defs.schema.json#/$defs/operationStep",
      "properties": {"transaction_class": {"const": "receipt_publication"}}}
  }
}
