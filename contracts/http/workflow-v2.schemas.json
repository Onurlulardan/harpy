{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "UUIDv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "SHA256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "PositiveRevision":{"type":"integer","minimum":1},
    "IdempotencyKey":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"},
    "WorkflowIDParameter":{"name":"workflow_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "WorkflowVersionIDParameter":{"name":"workflow_version_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "InstanceIDParameter":{"name":"instance_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TaskIDParameter":{"name":"task_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantIDParameter":{"name":"X-Tenant-ID","in":"header","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantSlugParameter":{"name":"X-Tenant-Slug","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":100}},
    "IdempotencyKeyParameter":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"$ref":"#/$defs/IdempotencyKey"}},
    "LimitParameter":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},
    "AfterCreatedAtParameter":{"name":"after_created_at","in":"query","required":false,"schema":{"type":"string","format":"date-time"}},
    "AfterWorkflowIDParameter":{"name":"after_workflow_id","in":"query","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "AfterOpenedAtParameter":{"name":"after_opened_at","in":"query","required":false,"schema":{"type":"string","format":"date-time"}},
    "AfterTaskIDParameter":{"name":"after_task_id","in":"query","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TaskStateParameter":{"name":"state","in":"query","required":false,"schema":{"enum":["pending","claimed","approved","rejected","expired","cancelled"]}},
    "CreateDefinitionRequest":{"type":"object","additionalProperties":false,"required":["slug","name","graph"],"properties":{"slug":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[a-z][a-z0-9-]{0,99}$"},"name":{"type":"string","minLength":1,"maxLength":200},"description":{"type":"string","maxLength":4000,"default":""},"graph":{"type":"object"}}},
    "UpdateDraftRequest":{"type":"object","additionalProperties":false,"required":["expected_definition_revision","expected_draft_revision","name","graph"],"properties":{"expected_definition_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_draft_revision":{"$ref":"#/$defs/PositiveRevision"},"name":{"type":"string","minLength":1,"maxLength":200},"description":{"type":"string","maxLength":4000,"default":""},"graph":{"type":"object"}}},
    "RenameDefinitionRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","slug"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"slug":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[a-z][a-z0-9-]{0,99}$"}}},
    "RetireDefinitionRequest":{"type":"object","additionalProperties":false,"required":["expected_revision"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "PublishRequest":{"type":"object","additionalProperties":false,"required":["expected_definition_revision","expected_draft_revision","service_principal_id","grant_id","grant_revision"],"properties":{"expected_definition_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_draft_revision":{"$ref":"#/$defs/PositiveRevision"},"service_principal_id":{"$ref":"#/$defs/UUIDv7"},"grant_id":{"$ref":"#/$defs/UUIDv7"},"grant_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "PublicationAuthorityRequest":{"type":"object","additionalProperties":false,"required":["expected_definition_revision","expected_draft_revision"],"properties":{"expected_definition_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_draft_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "StartInstanceRequest":{"type":"object","additionalProperties":false,"required":["causation_id","input"],"properties":{"causation_id":{"$ref":"#/$defs/UUIDv7"},"input":{"type":"object","maxProperties":500}}},
    "SignalInstanceRequest":{"type":"object","additionalProperties":false,"required":["causation_id","signal_key","payload"],"properties":{"causation_id":{"$ref":"#/$defs/UUIDv7"},"signal_key":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"},"payload":{"type":"object"}}},
    "CancelInstanceRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","causation_id"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"causation_id":{"$ref":"#/$defs/UUIDv7"}}},
    "ReplanInstanceRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","causation_id","reason","ticket"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"causation_id":{"$ref":"#/$defs/UUIDv7"},"reason":{"type":"string","minLength":1,"maxLength":512},"ticket":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}},
    "RepairInstanceRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","causation_id","target","reason","ticket"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"causation_id":{"$ref":"#/$defs/UUIDv7"},"target":{"enum":["running","waiting"]},"reason":{"type":"string","minLength":1,"maxLength":512},"ticket":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}},
    "TaskRevisionRequest":{"type":"object","additionalProperties":false,"required":["expected_revision"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "DecideTaskRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","decision"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"decision":{"enum":["approve","reject"]}}},
    "ReassignTaskRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","assignment_kind","assignment_id"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"assignment_kind":{"enum":["user","role","organization"]},"assignment_id":{"$ref":"#/$defs/UUIDv7"}}},
    "Definition":{"type":"object","additionalProperties":false,"required":["workflow_id","slug","name","description","lifecycle","active_version_id","definition_revision","draft_id","draft_revision","graph","graph_sha256","created_at","updated_at"],"properties":{"workflow_id":{"$ref":"#/$defs/UUIDv7"},"slug":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"lifecycle":{"enum":["active","retired"]},"active_version_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"definition_revision":{"$ref":"#/$defs/PositiveRevision"},"draft_id":{"$ref":"#/$defs/UUIDv7"},"draft_revision":{"$ref":"#/$defs/PositiveRevision"},"graph":{"type":"object"},"graph_sha256":{"$ref":"#/$defs/SHA256"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
    "DefinitionSummary":{"type":"object","additionalProperties":false,"required":["workflow_id","slug","name","description","lifecycle","active_version_id","definition_revision","draft_id","draft_revision","graph_sha256","created_at","updated_at"],"properties":{"workflow_id":{"$ref":"#/$defs/UUIDv7"},"slug":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"lifecycle":{"enum":["active","retired"]},"active_version_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"definition_revision":{"$ref":"#/$defs/PositiveRevision"},"draft_id":{"$ref":"#/$defs/UUIDv7"},"draft_revision":{"$ref":"#/$defs/PositiveRevision"},"graph_sha256":{"$ref":"#/$defs/SHA256"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
    "DefinitionCursor":{"type":"object","additionalProperties":false,"required":["created_at","workflow_id"],"properties":{"created_at":{"type":"string","format":"date-time"},"workflow_id":{"$ref":"#/$defs/UUIDv7"}}},
    "Publication":{"type":"object","additionalProperties":false,"required":["operation_id","workflow_id","draft_id","workflow_version_id","definition_revision","draft_revision","version_number","service_principal_id","grant_id","grant_revision","graph_sha256","program_sha256","registry_version","registry_sha256","budget_profile_id","budget_sha256","capability_manifest_sha256","forms_reference_manifest_sha256","node_count","edge_count","published_at"],"properties":{"operation_id":{"$ref":"#/$defs/UUIDv7"},"workflow_id":{"$ref":"#/$defs/UUIDv7"},"draft_id":{"$ref":"#/$defs/UUIDv7"},"workflow_version_id":{"$ref":"#/$defs/UUIDv7"},"definition_revision":{"$ref":"#/$defs/PositiveRevision"},"draft_revision":{"$ref":"#/$defs/PositiveRevision"},"version_number":{"$ref":"#/$defs/PositiveRevision"},"service_principal_id":{"$ref":"#/$defs/UUIDv7"},"grant_id":{"$ref":"#/$defs/UUIDv7"},"grant_revision":{"$ref":"#/$defs/PositiveRevision"},"graph_sha256":{"$ref":"#/$defs/SHA256"},"program_sha256":{"$ref":"#/$defs/SHA256"},"registry_version":{"type":"string"},"registry_sha256":{"$ref":"#/$defs/SHA256"},"budget_profile_id":{"type":"string"},"budget_sha256":{"$ref":"#/$defs/SHA256"},"capability_manifest_sha256":{"$ref":"#/$defs/SHA256"},"forms_reference_manifest_sha256":{"$ref":"#/$defs/SHA256"},"node_count":{"type":"integer","minimum":1,"maximum":500},"edge_count":{"type":"integer","minimum":0,"maximum":1000},"published_at":{"type":"string","format":"date-time"}}},
    "PublicationAuthority":{"type":"object","additionalProperties":false,"required":["service_principal_id","grant_id","grant_revision"],"properties":{"service_principal_id":{"$ref":"#/$defs/UUIDv7"},"grant_id":{"$ref":"#/$defs/UUIDv7"},"grant_revision":{"const":1}}},
    "Instance":{"type":"object","additionalProperties":false,"required":["instance_id","workflow_version_id","state","revision","transition_count","active_branches","plan_id","plan_revision","node_id","plan_sha256","service_principal_id","replay","budget_failure"],"properties":{"instance_id":{"$ref":"#/$defs/UUIDv7"},"workflow_version_id":{"$ref":"#/$defs/UUIDv7"},"state":{"enum":["running","waiting","cancellation_requested","cancelled","completed","failed","blocked"]},"revision":{"$ref":"#/$defs/PositiveRevision"},"transition_count":{"type":"integer","minimum":0,"maximum":10000},"active_branches":{"type":"integer","minimum":0,"maximum":200},"plan_id":{"$ref":"#/$defs/UUIDv7"},"plan_revision":{"$ref":"#/$defs/PositiveRevision"},"node_id":{"$ref":"#/$defs/UUIDv7"},"plan_sha256":{"$ref":"#/$defs/SHA256"},"service_principal_id":{"$ref":"#/$defs/UUIDv7"},"replay":{"type":"boolean"},"budget_failure":{"type":"boolean"}}},
    "TaskAssignment":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"enum":["user","role","organization"]},"id":{"$ref":"#/$defs/UUIDv7"}}},
    "TaskTerminal":{"type":"object","additionalProperties":false,"required":["state","actor_id","occurred_at"],"properties":{"state":{"enum":["approved","rejected","expired","cancelled"]},"actor_id":{"$ref":"#/$defs/UUIDv7"},"occurred_at":{"type":"string","format":"date-time"}}},
    "Task":{"type":"object","additionalProperties":false,"required":["task_id","instance_id","node_id","assignment","state","revision","claimed_by","opened_at","expires_at","updated_at","terminal","replay"],"properties":{"task_id":{"$ref":"#/$defs/UUIDv7"},"instance_id":{"$ref":"#/$defs/UUIDv7"},"node_id":{"$ref":"#/$defs/UUIDv7"},"assignment":{"$ref":"#/$defs/TaskAssignment"},"state":{"enum":["pending","claimed","approved","rejected","expired","cancelled"]},"revision":{"$ref":"#/$defs/PositiveRevision"},"claimed_by":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"opened_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"terminal":{"anyOf":[{"$ref":"#/$defs/TaskTerminal"},{"type":"null"}]},"replay":{"type":"boolean"}}},
    "TaskCursor":{"type":"object","additionalProperties":false,"required":["opened_at","task_id"],"properties":{"opened_at":{"type":"string","format":"date-time"},"task_id":{"$ref":"#/$defs/UUIDv7"}}},
    "DefinitionEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Definition"}}},
    "DefinitionPageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["items","next"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/DefinitionSummary"}},"next":{"anyOf":[{"$ref":"#/$defs/DefinitionCursor"},{"type":"null"}]}}}}},
    "PublicationEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Publication"}}},
    "PublicationAuthorityEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/PublicationAuthority"}}},
    "InstanceEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Instance"}}},
    "TaskEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Task"}}},
    "TaskPageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["items","next"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/Task"}},"next":{"anyOf":[{"$ref":"#/$defs/TaskCursor"},{"type":"null"}]}}}}},
    "ErrorResponse":{"description":"Fail-closed error","content":{"application/json":{"schema":{"$ref":"core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
