{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "UUIDv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "SHA256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "PositiveRevision":{"type":"integer","minimum":1},
    "IdempotencyKey":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"},
    "TenantIDParameter":{"name":"X-Tenant-ID","in":"header","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantSlugParameter":{"name":"X-Tenant-Slug","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":100}},
    "IdempotencyKeyParameter":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"$ref":"#/$defs/IdempotencyKey"}},
    "FolderIDParameter":{"name":"folder_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "DocumentIDParameter":{"name":"document_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "VersionIDParameter":{"name":"version_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "UploadIDParameter":{"name":"upload_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "ArchiveIDParameter":{"name":"archive_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "LimitParameter":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},
    "CreateFolderRequest":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"parent_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"name":{"type":"string","minLength":1,"maxLength":1024}}},
    "UpdateFolderRequest":{"type":"object","additionalProperties":false,"required":["expected_version","name"],"properties":{"expected_version":{"$ref":"#/$defs/PositiveRevision"},"name":{"type":"string","minLength":1,"maxLength":1024}}},
    "MoveFolderRequest":{"type":"object","additionalProperties":false,"required":["expected_version","parent_id"],"properties":{"expected_version":{"$ref":"#/$defs/PositiveRevision"},"parent_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]}}},
    "RevisionRequest":{"type":"object","additionalProperties":false,"required":["expected_version"],"properties":{"expected_version":{"$ref":"#/$defs/PositiveRevision"}}},
    "UpdateDocumentRequest":{"type":"object","additionalProperties":false,"required":["expected_version","description","tags"],"properties":{"expected_version":{"$ref":"#/$defs/PositiveRevision"},"description":{"type":"string","maxLength":4096},"tags":{"type":"array","maxItems":64,"items":{"type":"string","minLength":1,"maxLength":128}}}},
    "MoveDocumentRequest":{"type":"object","additionalProperties":false,"required":["expected_version","folder_id"],"properties":{"expected_version":{"$ref":"#/$defs/PositiveRevision"},"folder_id":{"$ref":"#/$defs/UUIDv7"}}},
    "CopyDocumentRequest":{"type":"object","additionalProperties":false,"required":["target_folder_id"],"properties":{"source_version_id":{"$ref":"#/$defs/UUIDv7"},"target_folder_id":{"$ref":"#/$defs/UUIDv7"},"original_name":{"type":"string","maxLength":255},"description":{"type":"string","maxLength":4096},"tags":{"type":"array","maxItems":64,"items":{"type":"string","maxLength":128}}}},
    "PurgeDocumentRequest":{"type":"object","additionalProperties":false,"required":["expected_version","reason"],"properties":{"expected_version":{"$ref":"#/$defs/PositiveRevision"},"reason":{"type":"string","minLength":3,"maxLength":2048}}},
    "BatchDocumentsRequest":{"type":"object","additionalProperties":false,"required":["document_ids"],"properties":{"document_ids":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/UUIDv7"}}}},
    "CreateUploadRequest":{"type":"object","additionalProperties":false,"required":["folder_id","original_name","declared_mime","expected_bytes","expected_sha256"],"properties":{"folder_id":{"$ref":"#/$defs/UUIDv7"},"document_id":{"$ref":"#/$defs/UUIDv7"},"expected_current_version_id":{"$ref":"#/$defs/UUIDv7"},"original_name":{"type":"string","minLength":1,"maxLength":255},"declared_mime":{"type":"string","minLength":1,"maxLength":255},"expected_bytes":{"type":"integer","minimum":1,"maximum":104857600},"expected_sha256":{"$ref":"#/$defs/SHA256"},"description":{"type":"string","maxLength":4096},"tags":{"type":"array","maxItems":64,"items":{"type":"string","maxLength":128}}}},
    "CreateArchiveRequest":{"type":"object","additionalProperties":false,"required":["document_ids"],"properties":{"document_ids":{"type":"array","minItems":1,"maxItems":10000,"uniqueItems":true,"items":{"$ref":"#/$defs/UUIDv7"}},"retry_of_archive_id":{"$ref":"#/$defs/UUIDv7"}}},
    "Folder":{"type":"object","additionalProperties":false,"required":["id","name","state","row_version"],"properties":{"id":{"$ref":"#/$defs/UUIDv7"},"parent_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"name":{"type":"string"},"state":{"enum":["active","trashed"]},"row_version":{"$ref":"#/$defs/PositiveRevision"}}},
    "Document":{"type":"object","additionalProperties":false,"required":["id","folder_id","state","row_version","current_version_id","description","tags"],"properties":{"id":{"$ref":"#/$defs/UUIDv7"},"folder_id":{"$ref":"#/$defs/UUIDv7"},"state":{"enum":["active","trashed","purge_cooling","purging","purged"]},"row_version":{"$ref":"#/$defs/PositiveRevision"},"current_version_id":{"$ref":"#/$defs/UUIDv7"},"description":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}}}},
    "Version":{"type":"object","additionalProperties":false,"required":["id","number","original_name","mime","bytes","sha256","created_at"],"properties":{"id":{"$ref":"#/$defs/UUIDv7"},"number":{"$ref":"#/$defs/PositiveRevision"},"original_name":{"type":"string"},"mime":{"type":"string"},"bytes":{"type":"integer","minimum":1},"sha256":{"$ref":"#/$defs/SHA256"},"created_at":{"type":"string","format":"date-time"}}},
    "Upload":{"type":"object","additionalProperties":false,"required":["id","document_id","candidate_version_id","state","attempt_generation","expected_bytes","expires_at"],"properties":{"id":{"$ref":"#/$defs/UUIDv7"},"document_id":{"$ref":"#/$defs/UUIDv7"},"candidate_version_id":{"$ref":"#/$defs/UUIDv7"},"state":{"enum":["created","receiving","retryable","scanning","ready","rejected","conflicted","cancelled","expired"]},"attempt_generation":{"type":"integer","minimum":0},"expected_bytes":{"type":"integer","minimum":1},"stable_error_code":{"type":"string"},"expires_at":{"type":"string","format":"date-time"}}},
    "Archive":{"type":"object","additionalProperties":false,"required":["id","job_id","state","entry_count","plaintext_bytes","created_at"],"properties":{"id":{"$ref":"#/$defs/UUIDv7"},"job_id":{"$ref":"#/$defs/UUIDv7"},"state":{"enum":["pending","ready","expired","purged"]},"entry_count":{"type":"integer","minimum":0,"maximum":10000},"plaintext_bytes":{"type":"integer","minimum":0,"maximum":10737418240},"ready_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"created_at":{"type":"string","format":"date-time"}}},
    "FolderEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Folder"}}},
    "DocumentEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Document"}}},
    "UploadEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Upload"}}},
    "ArchiveEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Archive"}}},
    "ErrorResponse":{"description":"Fail-closed error","content":{"application/json":{"schema":{"$ref":"core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
