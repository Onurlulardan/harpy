{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "UUIDv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "PositiveRevision":{"type":"integer","minimum":1},
    "ActiveRevision":{"type":"integer","minimum":0},
    "SHA256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "IdempotencyKey":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"},
    "FormIDParameter":{"name":"form_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "FormVersionIDParameter":{"name":"form_version_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "PublicationIDParameter":{"name":"publication_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantIDParameter":{"name":"X-Tenant-ID","in":"header","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantSlugParameter":{"name":"X-Tenant-Slug","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":100}},
    "IdempotencyKeyParameter":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"$ref":"#/$defs/IdempotencyKey"}},
    "LimitParameter":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},
    "AfterFormIDParameter":{"name":"after_form_id","in":"query","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "CreateDefinitionRequest":{"type":"object","additionalProperties":false,"required":["slug","definition"],"properties":{"slug":{"type":"string","minLength":1,"maxLength":100},"definition":{"type":"object"}}},
    "UpdateDefinitionDraftRequest":{"type":"object","additionalProperties":false,"required":["slug","definition","expected_definition_revision","expected_version_revision"],"properties":{"slug":{"type":"string","minLength":1,"maxLength":100},"definition":{"type":"object"},"expected_definition_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_version_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "CreateDefinitionVersionRequest":{"type":"object","additionalProperties":false,"required":["source_version_id","expected_definition_revision","expected_source_revision","expected_active_revision"],"properties":{"source_version_id":{"$ref":"#/$defs/UUIDv7"},"expected_definition_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_source_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_active_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "RetireDefinitionRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","reason"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"reason":{"type":"string","minLength":1,"maxLength":1000}}},
    "CreatePublicationRequest":{"type":"object","additionalProperties":false,"required":["expected_version_revision"],"properties":{"expected_version_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "ValidatePublicationRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","expected_version_revision"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_version_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "PlanPublicationRequest":{"type":"object","additionalProperties":false,"required":["expected_revision"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "ActivePublicationRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","expected_version_revision","expected_active_revision"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_version_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_active_revision":{"$ref":"#/$defs/ActiveRevision"}}},
    "DeactivatePublicationRequest":{"type":"object","additionalProperties":false,"required":["expected_revision","expected_version_revision","expected_active_revision"],"properties":{"expected_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_version_revision":{"$ref":"#/$defs/PositiveRevision"},"expected_active_revision":{"$ref":"#/$defs/PositiveRevision"}}},
    "Definition":{"type":"object","additionalProperties":false,"required":["form_id","definition_revision","reference_epoch","lifecycle","version_id","version_number","version_revision","version_state","slug","definition","definition_sha256","created_at","updated_at"],"properties":{"form_id":{"$ref":"#/$defs/UUIDv7"},"definition_revision":{"$ref":"#/$defs/PositiveRevision"},"reference_epoch":{"$ref":"#/$defs/PositiveRevision"},"lifecycle":{"enum":["active","retired","purge_pending","purged"]},"version_id":{"$ref":"#/$defs/UUIDv7"},"version_number":{"$ref":"#/$defs/PositiveRevision"},"version_revision":{"$ref":"#/$defs/PositiveRevision"},"version_state":{"enum":["draft","published","retired"]},"slug":{"type":"string"},"definition":{"type":"object"},"definition_sha256":{"$ref":"#/$defs/SHA256"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
    "Publication":{"type":"object","additionalProperties":false,"required":["publication_id","definition_id","version_id","state","revision","version_revision","plan_id","plan_sha256","schema_job_id","schema_job_generation","apply_succeeded","failure_code","active","active_revision","created_at","updated_at"],"properties":{"publication_id":{"$ref":"#/$defs/UUIDv7"},"definition_id":{"$ref":"#/$defs/UUIDv7"},"version_id":{"$ref":"#/$defs/UUIDv7"},"state":{"enum":["draft","validated","planned","applying","failed","published"]},"revision":{"$ref":"#/$defs/PositiveRevision"},"version_revision":{"$ref":"#/$defs/PositiveRevision"},"plan_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"plan_sha256":{"anyOf":[{"$ref":"#/$defs/SHA256"},{"type":"null"}]},"schema_job_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"schema_job_generation":{"type":"integer","minimum":0},"apply_succeeded":{"type":"boolean"},"failure_code":{"type":"string"},"active":{"type":"boolean"},"active_revision":{"type":"integer","minimum":0},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
    "Retirement":{"type":"object","additionalProperties":false,"required":["operation_id","definition_id","revision","epoch","lifecycle","retired_at","replay"],"properties":{"operation_id":{"$ref":"#/$defs/UUIDv7"},"definition_id":{"$ref":"#/$defs/UUIDv7"},"revision":{"$ref":"#/$defs/PositiveRevision"},"epoch":{"$ref":"#/$defs/PositiveRevision"},"lifecycle":{"const":"retired"},"retired_at":{"type":"string","format":"date-time"},"replay":{"type":"boolean"}}},
    "DefinitionEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Definition"}}},
    "PublicationEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Publication"}}},
    "RetirementEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Retirement"}}},
    "DefinitionPageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["items","next_after_form_id"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/Definition"}},"next_after_form_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]}}}}},
    "ErrorResponse":{"description":"Fail-closed error","content":{"application/json":{"schema":{"$ref":"core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
