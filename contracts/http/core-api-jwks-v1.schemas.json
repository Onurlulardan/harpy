{
  "schemas": {
    "JWK": {
      "type": "object", "additionalProperties": false,
      "required": ["kty", "crv", "x", "use", "kid", "alg"],
      "properties": {
        "kty": {"const": "OKP"}, "crv": {"const": "Ed25519"},
        "x": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "use": {"const": "sig"},
        "kid": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,64}$"},
        "alg": {"const": "Ed25519"}
      }
    },
    "JWKS": {
      "type": "object", "additionalProperties": false, "required": ["keys"],
      "properties": {
        "keys": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/schemas/JWK"}}
      }
    }
  }
}
