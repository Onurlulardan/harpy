{
  "version": 1,
  "surface": "frontend-v3/forms-portal",
  "excluded_surfaces": ["ai", "mcp"],
  "routes": [
    {"method":"GET","path":"/api/portal/me","state":"active","consumer":"getPortalMe"},
    {"method":"GET","path":"/api/portal/forms","state":"active","consumer":"listPortalForms"},
    {"method":"GET","path":"/api/portal/forms/{slug}/config","state":"active","consumer":"getPortalFormConfig"},
    {"method":"GET","path":"/api/portal/forms/{slug}/options/{field}","state":"active","consumer":"loadDataSourcePage"},
    {"method":"GET","path":"/api/portal/forms/{slug}/records","state":"active","consumer":"listPortalRecords"},
    {"method":"POST","path":"/api/portal/forms/{slug}/records","state":"active","consumer":"createPortalRecord"},
    {"method":"GET","path":"/api/portal/forms/{slug}/records/{id}","state":"retired_410","consumer":"v1-only"},
    {"method":"PATCH","path":"/api/portal/forms/{slug}/records/{id}","state":"active","consumer":"updatePortalRecord"},
    {"method":"POST","path":"/api/portal/forms/{slug}/records/{id}/cancel","state":"active","consumer":"cancelPortalRecord"},
    {"method":"POST","path":"/api/portal/forms/{slug}/records/{id}/submit","state":"active","consumer":"submitPortalRecord"},
    {"method":"GET","path":"/api/portal/forms/{slug}/records/{id}/print","state":"active","consumer":"printPortalRecord"}
  ]
}
