{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "UUIDv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "IdempotencyKey": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"},
    "FormIDParameter": {"name": "form_id", "in": "path", "required": true, "schema": {"$ref": "#/$defs/UUIDv7"}},
    "FormVersionIDParameter": {"name": "form_version_id", "in": "path", "required": true, "schema": {"$ref": "#/$defs/UUIDv7"}},
    "PublicationIDParameter": {"name": "publication_id", "in": "path", "required": true, "schema": {"$ref": "#/$defs/UUIDv7"}},
    "RecordIDParameter": {"name": "record_id", "in": "path", "required": true, "schema": {"$ref": "#/$defs/UUIDv7"}},
    "FieldName": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "FieldParameter": {"name": "field", "in": "path", "required": true, "schema": {"$ref": "#/$defs/FieldName"}},
    "TenantIDParameter": {"name": "X-Tenant-ID", "in": "header", "required": false, "schema": {"$ref": "#/$defs/UUIDv7"}},
    "TenantSlugParameter": {"name": "X-Tenant-Slug", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 100}},
    "IdempotencyKeyParameter": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"$ref": "#/$defs/IdempotencyKey"}},
    "IfMatchParameter": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^\\\"row-version-[1-9][0-9]*\\\"$"}},
    "MutationActionParameter": {"name": "action", "in": "query", "required": true, "schema": {"enum": ["create", "update"]}},
    "OptionLimitParameter": {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}},
    "OptionAfterParameter": {"name": "after", "in": "query", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 16384}},
    "OptionSearchParameter": {"name": "search", "in": "query", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
    "OptionValueParameter": {"name": "value", "in": "query", "required": false, "schema": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "style": "form", "explode": true},
    "OptionLabelFieldParameter": {"name": "label_field", "in": "query", "required": false, "schema": {"$ref": "#/$defs/FieldName"}},
    "RecordDocument": {"type": "object", "maxProperties": 500},
    "Mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "record_id", "row_version"],
      "properties": {"receipt_id": {"$ref": "#/$defs/UUIDv7"}, "record_id": {"$ref": "#/$defs/UUIDv7"}, "row_version": {"type": "integer", "minimum": 1}}
    },
    "Record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_version", "fields"],
      "properties": {"id": {"$ref": "#/$defs/UUIDv7"}, "row_version": {"type": "integer", "minimum": 1}, "fields": {"$ref": "#/$defs/RecordDocument"}}
    },
    "MutationEnvelope": {"type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "#/$defs/Mutation"}}},
    "RecordEnvelope": {"type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "#/$defs/Record"}}},
    "QueryPagination": {
      "type": "object", "additionalProperties": false,
      "required": ["next", "next_transport", "size"],
      "properties": {"next": {"type": ["string", "null"], "maxLength": 16384}, "next_transport": {"const": "POST"}, "size": {"type": "integer", "minimum": 0, "maximum": 500}, "total": {"type": "integer", "minimum": 0}}
    },
    "QueryData": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "pagination", "meta"],
      "properties": {"items": {"type": "array", "maxItems": 500, "items": {"type": "object"}}, "pagination": {"$ref": "#/$defs/QueryPagination"}, "meta": {"type": "object"}}
    },
    "QueryEnvelope": {"type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "#/$defs/QueryData"}}},
    "WriteSchemaField": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "type", "nullable", "required", "immutable"],
      "properties": {
        "id": {"$ref": "#/$defs/UUIDv7"}, "name": {"$ref": "#/$defs/FieldName"},
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "nullable": {"type": "boolean"}, "required": {"type": "boolean"}, "immutable": {"type": "boolean"},
        "text_minimum": {"type": "integer", "minimum": 0},
        "text_maximum": {"type": "integer", "minimum": 0},
        "decimal_precision": {"type": "integer", "minimum": 1},
        "decimal_scale": {"type": "integer", "minimum": 0},
        "options": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 256}},
        "options_truncated": {"type": "boolean"}, "target_form_id": {"$ref": "#/$defs/UUIDv7"},
        "cardinality": {"enum": ["one", "many"]}
      }
    },
    "WriteSchema": {
      "type": "object", "additionalProperties": false,
      "required": ["publication_id", "form_id", "form_version_id", "action", "catalog_sha256", "fields"],
      "properties": {
        "publication_id": {"$ref": "#/$defs/UUIDv7"}, "form_id": {"$ref": "#/$defs/UUIDv7"},
        "form_version_id": {"$ref": "#/$defs/UUIDv7"}, "action": {"enum": ["create", "update"]},
        "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fields": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/WriteSchemaField"}}
      }
    },
    "Validation": {
      "type": "object", "additionalProperties": false,
      "required": ["valid", "action", "field_count", "instruction_count", "result_sha256"],
      "properties": {
        "valid": {"const": true}, "action": {"enum": ["create", "update"]},
        "field_count": {"type": "integer", "minimum": 0, "maximum": 500},
        "instruction_count": {"type": "integer", "minimum": 0},
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_row_version": {"type": "integer", "minimum": 1}
      }
    },
    "OptionItem": {
      "type": "object", "additionalProperties": false, "required": ["value", "label"],
      "properties": {"value": {"type": "string", "minLength": 1, "maxLength": 256}, "label": {"type": "string", "maxLength": 1024}}
    },
    "OptionPage": {
      "type": "object", "additionalProperties": false, "required": ["items", "next", "has_more", "size"],
      "properties": {
        "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/OptionItem"}},
        "next": {"type": ["string", "null"], "maxLength": 16384}, "has_more": {"type": "boolean"},
        "size": {"type": "integer", "minimum": 0, "maximum": 50},
        "label_field": {"$ref": "#/$defs/FieldName"}
      }
    },
    "WriteSchemaEnvelope": {"type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "#/$defs/WriteSchema"}}},
    "ValidationEnvelope": {"type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "#/$defs/Validation"}}},
    "OptionEnvelope": {"type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": {"success": {"const": true}, "data": {"$ref": "#/$defs/OptionPage"}}},
    "MutationResponse": {"description": "Durable mutation", "headers": {"ETag": {"schema": {"type": "string"}}, "Location": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/$defs/MutationEnvelope"}}}},
    "RecordResponse": {"description": "Exact record", "headers": {"ETag": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/$defs/RecordEnvelope"}}}},
    "QueryResponse": {"description": "Authorized record page", "content": {"application/json": {"schema": {"$ref": "#/$defs/QueryEnvelope"}}}},
    "WriteSchemaResponse": {"description": "Actor-writable exact publication schema", "content": {"application/json": {"schema": {"$ref": "#/$defs/WriteSchemaEnvelope"}}}},
    "ValidationResponse": {"description": "Side-effect-free record validation", "content": {"application/json": {"schema": {"$ref": "#/$defs/ValidationEnvelope"}}}},
    "OptionResponse": {"description": "Bounded actor-authorized option page", "content": {"application/json": {"schema": {"$ref": "#/$defs/OptionEnvelope"}}}},
    "ErrorResponse": {"description": "Fail-closed error", "content": {"application/json": {"schema": {"$ref": "core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
