{
  "parameters": {
    "TenantID": {"name": "X-Tenant-ID", "in": "header", "required": false, "schema": {"type": "string", "format": "uuid"}, "description": "Optional mismatch assertion; never tenant authority."},
    "TenantSlug": {"name": "X-Tenant-Slug", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 128}, "description": "Optional mismatch assertion; never tenant authority."},
    "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-~]+$"}},
    "OfferingID": {"name": "offering_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
    "SubscriptionID": {"name": "subscription_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
    "DiscountID": {"name": "discount_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
    "CampaignID": {"name": "campaign_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
    "Provider": {"name": "provider", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z][a-z0-9._-]*$"}}
  },
  "schemas": {
    "UTCMicrosecond": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
    "PositiveRevision": {"type": "integer", "format": "int64", "minimum": 1},
    "Issue": {
      "type": "object", "additionalProperties": false, "required": ["path", "code"],
      "properties": {
        "path": {"type": "string", "maxLength": 256, "pattern": "^(?:/(?:[^~/]|~[01])*)*$"},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}
      }
    },
    "SuccessEnvelope": {
      "type": "object", "additionalProperties": false, "required": ["success", "data"],
      "properties": {"success": {"const": true}, "data": {}}
    },
    "UsageLimitDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["entitlement_key", "current", "requested", "limit", "period_start", "period_end", "reset_policy"],
      "properties": {
        "entitlement_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "current": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "requested": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "limit": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "period_start": {"$ref": "#/schemas/UTCMicrosecond"},
        "period_end": {"$ref": "#/schemas/UTCMicrosecond"},
        "reset_policy": {"enum": ["billing_period", "calendar_month_utc", "never"]}
      }
    },
    "BillingErrorEnvelope": {
      "type": "object", "additionalProperties": false, "required": ["success", "error"],
      "properties": {
        "success": {"const": false},
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message", "issues", "correlation_id"],
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
            "message": {"type": "string", "minLength": 1, "maxLength": 128},
            "issues": {"type": "array", "maxItems": 20, "items": {"$ref": "#/schemas/Issue"}},
            "details": {"$ref": "#/schemas/UsageLimitDetails"},
            "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
          }
        }
      }
    }
  },
  "responses": {
    "Success": {"description": "Successful Billing result.", "content": {"application/json": {"schema": {"$ref": "#/schemas/SuccessEnvelope"}}}},
    "Invalid": {"description": "Strict request validation failed.", "x-harpy-error-code": "REQUEST_INVALID", "content": {"application/json": {"schema": {"$ref": "#/schemas/BillingErrorEnvelope"}}}},
    "Unauthorized": {"description": "Actor authentication failed.", "x-harpy-error-code": "AUTHENTICATION_FAILED", "content": {"application/json": {"schema": {"$ref": "#/schemas/BillingErrorEnvelope"}}}},
    "Forbidden": {"description": "Verified actor lacks the exact permission.", "x-harpy-error-code": "AUTHORIZATION_DENIED", "content": {"application/json": {"schema": {"$ref": "#/schemas/BillingErrorEnvelope"}}}},
    "NotFound": {"description": "Billing resource was not found.", "x-harpy-error-code": "RESOURCE_NOT_FOUND", "content": {"application/json": {"schema": {"$ref": "#/schemas/BillingErrorEnvelope"}}}},
    "Conflict": {"description": "Billing invariant or idempotency conflict.", "x-harpy-error-code": "BILLING_CONFLICT", "content": {"application/json": {"schema": {"$ref": "#/schemas/BillingErrorEnvelope"}}}},
    "RevisionStale": {"description": "Expected root revision is stale.", "x-harpy-error-code": "BILLING_REVISION_STALE", "content": {"application/json": {"schema": {"$ref": "#/schemas/BillingErrorEnvelope"}}}},
    "UsageLimit": {"description": "Atomic hard usage reservation denied.", "x-harpy-error-code": "USAGE_LIMIT_EXCEEDED", "content": {"application/json": {"schema": {"$ref": "#/schemas/BillingErrorEnvelope"}}}},
    "Unavailable": {"description": "Billing authority is unavailable and bounded work fails closed.", "x-harpy-error-code": "BILLING_AUTHORITY_UNAVAILABLE", "content": {"application/json": {"schema": {"$ref": "#/schemas/BillingErrorEnvelope"}}}}
  }
}
