{
  "schemas": {
    "EmptyObject": {
      "type": "object", "additionalProperties": false, "maxProperties": 0
    },
    "OperatorLoginRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_slug", "email", "password"],
      "properties": {
        "tenant_slug": {"type": "string", "minLength": 1, "maxLength": 128},
        "email": {"type": "string", "minLength": 3, "maxLength": 1024},
        "password": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "PortalLoginRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_slug", "identifier", "password"],
      "properties": {
        "tenant_slug": {"type": "string", "minLength": 1, "maxLength": 128},
        "identifier": {"type": "string", "minLength": 1, "maxLength": 512},
        "password": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "AuthGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "expires_at"],
      "properties": {
        "token": {"type": "string", "minLength": 1, "maxLength": 8192},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "ReauthenticationStartRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose_sha256", "method", "authenticator_id"],
      "properties": {
        "purpose_sha256": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "method": {"enum": ["password_v1", "webauthn_v1", "totp_v1"]},
        "authenticator_id": {"type": ["string", "null"], "format": "uuid"}
      },
      "oneOf": [
        {"properties": {"method": {"const": "password_v1"}, "authenticator_id": {"type": "null"}}},
        {"properties": {"method": {"enum": ["webauthn_v1", "totp_v1"]}, "authenticator_id": {"type": "string", "format": "uuid"}}}
      ]
    },
    "ReauthenticationWebAuthnOptions": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_id", "rp_id", "user_verification_required"],
      "properties": {
        "credential_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 2048},
        "rp_id": {"type": "string", "minLength": 1, "maxLength": 253},
        "user_verification_required": {"type": "boolean"}
      }
    },
    "ReauthenticationChallenge": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_id", "method", "challenge", "expires_at", "action_policy_version", "webauthn"],
      "properties": {
        "challenge_id": {"type": "string", "format": "uuid"},
        "method": {"enum": ["password_v1", "webauthn_v1", "totp_v1"]},
        "challenge": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "expires_at": {"type": "string", "format": "date-time"},
        "action_policy_version": {"type": "integer", "format": "int64", "const": 1},
        "webauthn": {"oneOf": [{"$ref": "#/schemas/ReauthenticationWebAuthnOptions"}, {"type": "null"}]}
      },
      "oneOf": [
        {"properties": {"method": {"const": "webauthn_v1"}, "webauthn": {"$ref": "#/schemas/ReauthenticationWebAuthnOptions"}}},
        {"properties": {"method": {"enum": ["password_v1", "totp_v1"]}, "webauthn": {"type": "null"}}}
      ]
    },
    "ReauthenticationCompleteRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_id", "challenge", "purpose_sha256", "method", "proof"],
      "properties": {
        "challenge_id": {"type": "string", "format": "uuid"},
        "challenge": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "purpose_sha256": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "method": {"enum": ["password_v1", "webauthn_v1", "totp_v1"]},
        "proof": {"type": "object"}
      },
      "oneOf": [
        {"properties": {"method": {"const": "password_v1"}, "proof": {"type": "object", "additionalProperties": false, "required": ["password"], "properties": {"password": {"type": "string", "minLength": 1, "maxLength": 512}}}}},
        {"properties": {"method": {"const": "totp_v1"}, "proof": {"type": "object", "additionalProperties": false, "required": ["totp"], "properties": {"totp": {"type": "string", "pattern": "^[0-9]{6}$"}}}}},
        {"properties": {"method": {"const": "webauthn_v1"}, "proof": {"type": "object", "additionalProperties": false, "required": ["webauthn_assertion"], "properties": {"webauthn_assertion": {"type": "object", "minProperties": 1, "maxProperties": 16}}}}}
      ]
    },
    "CurrentSession": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "user_id", "tenant_id", "tenant_slug", "client_id", "access_mode", "token_version", "authorization_version", "password_credential_revision", "deployment_mode", "platform_capabilities", "tenant_capabilities", "auth_time", "expires_at", "acr", "amr"],
      "properties": {
        "session_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "tenant_slug": {"type": "string", "minLength": 1, "maxLength": 128},
        "client_id": {"enum": ["harpy-operator-console-v1", "harpy-portal-v1"]},
        "access_mode": {"enum": ["operator_console", "portal"]},
        "portal_binding_id": {"type": "string", "format": "uuid"},
        "token_version": {"type": "integer", "format": "int64", "minimum": 1},
        "authorization_version": {"type": "integer", "format": "int64", "minimum": 1},
        "password_credential_revision": {"type": ["integer", "null"], "format": "int64", "minimum": 1},
        "deployment_mode": {"enum": ["onpremise", "saas"]},
        "platform_capabilities": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^platform\\.", "minLength": 1, "maxLength": 128}},
        "tenant_capabilities": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "auth_time": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "acr": {"enum": ["urn:harpy:acr:baseline", "urn:harpy:acr:step-up"]},
        "amr": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"enum": ["pwd", "webauthn", "totp"]}}
      }
    }
  },
  "securitySchemes": {
    "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "Harpy Ed25519 access token"}
  },
  "parameters": {
    "Origin": {"name": "Origin", "in": "header", "required": true, "schema": {"type": "string", "format": "uri", "maxLength": 512}},
    "CSRFHeader": {"name": "X-CSRF-Token", "in": "header", "required": true, "schema": {"type": "string", "maxLength": 192}},
    "RefreshCookie": {"name": "__Secure-harpy-refresh", "in": "cookie", "required": true, "schema": {"type": "string", "maxLength": 66}},
    "CSRFCookie": {"name": "__Host-harpy-csrf", "in": "cookie", "required": true, "schema": {"type": "string", "maxLength": 192}},
    "TenantID": {"name": "X-Tenant-ID", "in": "header", "required": false, "schema": {"type": "string", "format": "uuid"}},
    "TenantSlug": {"name": "X-Tenant-Slug", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 128}}
  },
  "responses": {
    "AuthGrant": {
      "description": "Access token plus rotated secure refresh and readable CSRF cookies.",
      "headers": {"Set-Cookie": {"description": "Host-only refresh and CSRF cookies.", "schema": {"type": "string"}}},
      "content": {"application/json": {"schema": {"$ref": "#/schemas/AuthGrant"}}}
    },
    "ReauthenticationChallenge": {
      "description": "Purpose-bound challenge; the challenge material is revealed once and is never a bearer grant.",
      "content": {"application/json": {"schema": {"$ref": "#/schemas/ReauthenticationChallenge"}}}
    },
    "CurrentSession": {
      "description": "Current canonical IAM session and authorization view.",
      "content": {"application/json": {"schema": {"$ref": "#/schemas/CurrentSession"}}}
    },
    "NoContent": {
      "description": "The browser credential operation completed.",
      "headers": {"Set-Cookie": {"description": "Issued or expired host-only auth cookies.", "schema": {"type": "string"}}}
    },
    "RequestInvalid": {
      "description": "The request document is invalid.", "x-harpy-error-code": "REQUEST_INVALID",
      "content": {"application/json": {"schema": {"$ref": "../runtime/v1/error-envelope.schema.json"}}}
    },
    "BodyTooLarge": {
      "description": "The request body exceeds the endpoint limit.", "x-harpy-error-code": "REQUEST_BODY_TOO_LARGE",
      "content": {"application/json": {"schema": {"$ref": "../runtime/v1/error-envelope.schema.json"}}}
    },
    "MediaTypeUnsupported": {
      "description": "The request media type is unsupported.", "x-harpy-error-code": "MEDIA_TYPE_UNSUPPORTED",
      "content": {"application/json": {"schema": {"$ref": "../runtime/v1/error-envelope.schema.json"}}}
    },
    "AuthenticationFailed": {
      "description": "No identity, tenant, or credential detail is disclosed.", "x-harpy-error-code": "AUTHENTICATION_FAILED",
      "content": {"application/json": {"schema": {"$ref": "../runtime/v1/error-envelope.schema.json"}}}
    },
    "CSRFInvalid": {
      "description": "Origin or CSRF proof is invalid.", "x-harpy-error-code": "AUTH_CSRF_INVALID",
      "content": {"application/json": {"schema": {"$ref": "../runtime/v1/error-envelope.schema.json"}}}
    },
    "AuthenticationUnavailable": {
      "description": "IAM authority cannot safely complete the operation.", "x-harpy-error-code": "AUTHENTICATION_UNAVAILABLE",
      "content": {"application/json": {"schema": {"$ref": "../runtime/v1/error-envelope.schema.json"}}}
    },
    "MethodNotAllowed": {
      "description": "The path exists but the method is not published.", "x-harpy-error-code": "METHOD_NOT_ALLOWED",
      "content": {"application/json": {"schema": {"$ref": "../runtime/v1/error-envelope.schema.json"}}}
    }
  }
}
