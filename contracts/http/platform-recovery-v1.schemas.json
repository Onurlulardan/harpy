{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "UUID":{"type":"string","format":"uuid"},
    "SHA256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "Envelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{}}},
    "OperationAccepted":{"type":"object","additionalProperties":false,"required":["operation_id","state"],"properties":{"operation_id":{"$ref":"#/$defs/UUID"},"state":{"const":"accepted"}}},
    "OperationAcceptedEnvelope":{"allOf":[{"$ref":"#/$defs/Envelope"},{"properties":{"data":{"$ref":"#/$defs/OperationAccepted"}}}]},
    "Protection":{"type":"object","additionalProperties":false,"required":["environment_id","state","generation","kit_acknowledged"],"properties":{"environment_id":{"$ref":"#/$defs/UUID"},"state":{"enum":["unprotected","protected","rotation_pending","disable_pending"]},"generation":{"type":"integer","minimum":0},"kit_acknowledged":{"type":"boolean"},"active_anchor_count":{"type":"integer","minimum":0},"updated_at":{"type":"string","format":"date-time"}}},
    "ProtectionEnvelope":{"allOf":[{"$ref":"#/$defs/Envelope"},{"properties":{"data":{"$ref":"#/$defs/Protection"}}}]},
    "ProtectionClaimRequest":{"type":"object","additionalProperties":false,"required":["claim"],"properties":{"claim":{"type":"object","additionalProperties":false,"required":["algorithm","public_key_base64url"],"properties":{"algorithm":{"const":"HPKE-v1-X25519-HKDF-SHA256-AES-256-GCM"},"public_key_base64url":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"}}}}},
    "RecoveryOperation":{"type":"object","additionalProperties":false,"required":["operation_id","kind","state","kit_claim_state","created_at"],"properties":{"operation_id":{"$ref":"#/$defs/UUID"},"kind":{"enum":["enable","rotate","disable","anchor_register","anchor_delete"]},"state":{"enum":["accepted","handoff_ready","kit_ready","completed","failed","compensated"]},"kit_claim_state":{"enum":["not_applicable","pending","ready","downloaded","acknowledged","expired"]},"artifact_sha256":{"anyOf":[{"$ref":"#/$defs/SHA256"},{"type":"null"}]},"expires_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"failure_code":{"anyOf":[{"type":"string"},{"type":"null"}]},"created_at":{"type":"string","format":"date-time"}}},
    "RecoveryOperationEnvelope":{"allOf":[{"$ref":"#/$defs/Envelope"},{"properties":{"data":{"$ref":"#/$defs/RecoveryOperation"}}}]},
    "SealedRecoveryKit":{"type":"object","additionalProperties":false,"required":["schema","suite","environment_id","operation_id","generation","claim_public_key_sha256","issued_at","expires_at","encapsulated_key_base64url","ciphertext_base64url"],"properties":{"schema":{"const":"environment-recovery-kit.hpke.v1"},"suite":{"const":"DHKEM(X25519,HKDF-SHA256)/HKDF-SHA256/AES-256-GCM"},"environment_id":{"$ref":"#/$defs/UUID"},"operation_id":{"$ref":"#/$defs/UUID"},"generation":{"type":"integer","minimum":1},"claim_public_key_sha256":{"$ref":"#/$defs/SHA256"},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"encapsulated_key_base64url":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},"ciphertext_base64url":{"type":"string","minLength":23,"maxLength":2796203,"pattern":"^[A-Za-z0-9_-]+$"}}},
    "KitAckRequest":{"type":"object","additionalProperties":false,"required":["artifact_sha256","ack_proof_base64url"],"properties":{"artifact_sha256":{"$ref":"#/$defs/SHA256"},"ack_proof_base64url":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"}}},
    "Anchor":{"type":"object","additionalProperties":false,"required":["anchor_id","generation","credential_id_base64url","rp_id","user_verification","backup_eligible","backup_state","state"],"properties":{"anchor_id":{"$ref":"#/$defs/UUID"},"generation":{"type":"integer","minimum":1},"credential_id_base64url":{"type":"string","minLength":1},"rp_id":{"type":"string","minLength":1},"user_verification":{"const":"required"},"backup_eligible":{"const":false},"backup_state":{"const":false},"state":{"enum":["pending","active","stale","deleted"]}}},
    "AnchorsEnvelope":{"allOf":[{"$ref":"#/$defs/Envelope"},{"properties":{"data":{"type":"array","items":{"$ref":"#/$defs/Anchor"}}}}]},
    "AnchorOptionsEnvelope":{"allOf":[{"$ref":"#/$defs/Envelope"},{"properties":{"data":{"type":"object","required":["operation_id","public_key"],"properties":{"operation_id":{"$ref":"#/$defs/UUID"},"public_key":{"type":"object"}}}}}]},
    "AnchorRegistrationRequest":{"type":"object","additionalProperties":false,"required":["operation_id","credential"],"properties":{"operation_id":{"$ref":"#/$defs/UUID"},"credential":{"type":"object"}}},
    "RecoverySet":{"type":"object","additionalProperties":false,"required":["recovery_set_id","operation_id","environment_id","sequence","state","manifest_sha256","legal_hold","database_system_id","protected_at"],"properties":{"recovery_set_id":{"$ref":"#/$defs/UUID"},"operation_id":{"$ref":"#/$defs/UUID"},"environment_id":{"$ref":"#/$defs/UUID"},"sequence":{"type":"integer","minimum":1},"state":{"type":"string","minLength":1},"manifest_sha256":{"anyOf":[{"$ref":"#/$defs/SHA256"},{"type":"null"}]},"legal_hold":{"type":"boolean"},"database_system_id":{"anyOf":[{"$ref":"#/$defs/UUID"},{"type":"null"}]},"protected_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]}}},
    "RecoverySetAcceptedEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["recovery_set_id","operation_id","environment_id","sequence","state"],"properties":{"recovery_set_id":{"$ref":"#/$defs/UUID"},"operation_id":{"$ref":"#/$defs/UUID"},"environment_id":{"$ref":"#/$defs/UUID"},"sequence":{"type":"integer","minimum":1},"state":{"const":"requested"}}}}},
    "RecoverySetEnvelope":{"allOf":[{"$ref":"#/$defs/Envelope"},{"properties":{"data":{"$ref":"#/$defs/RecoverySet"}}}]},
    "RecoverySetsEnvelope":{"allOf":[{"$ref":"#/$defs/Envelope"},{"properties":{"data":{"type":"object","additionalProperties":false,"required":["items"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/RecoverySet"}}}}}}]},
    "RestoreRequest":{"type":"object","additionalProperties":false,"required":["target_disposition","destructive_confirmed"],"properties":{"target_disposition":{"enum":["existing_readable","empty","unreadable"]},"safety_recovery_set_id":{"anyOf":[{"$ref":"#/$defs/UUID"},{"type":"null"}]},"safety_recovery_set_sha256":{"anyOf":[{"$ref":"#/$defs/SHA256"},{"type":"null"}]},"waiver_reason":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"probe_sha256":{"anyOf":[{"$ref":"#/$defs/SHA256"},{"type":"null"}]},"destructive_confirmed":{"type":"boolean"}}},
    "RestoreOperation":{"type":"object","additionalProperties":false,"required":["operation_id","recovery_set_id","environment_id","disposition","state","plan_sha256","receipt_sha256","new_database_system_id","created_at","updated_at","completed_at"],"properties":{"operation_id":{"$ref":"#/$defs/UUID"},"recovery_set_id":{"$ref":"#/$defs/UUID"},"environment_id":{"$ref":"#/$defs/UUID"},"disposition":{"enum":["existing_readable","empty","unreadable"]},"state":{"type":"string","minLength":1},"plan_sha256":{"anyOf":[{"$ref":"#/$defs/SHA256"},{"type":"null"}]},"receipt_sha256":{"anyOf":[{"$ref":"#/$defs/SHA256"},{"type":"null"}]},"new_database_system_id":{"anyOf":[{"$ref":"#/$defs/UUID"},{"type":"null"}]},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"completed_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]}}},
    "RestoreOperationEnvelope":{"allOf":[{"$ref":"#/$defs/Envelope"},{"properties":{"data":{"$ref":"#/$defs/RestoreOperation"}}}]}
  }
}
