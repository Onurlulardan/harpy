{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Status": {"enum":["healthy","degraded","unhealthy","unknown"]},
    "Component": {
      "type":"object","additionalProperties":false,
      "required":["name","status","response_ms","last_checked"],
      "properties":{
        "name":{"type":"string","minLength":1,"maxLength":100},
        "url":{"type":"string","maxLength":256},
        "status":{"$ref":"#/$defs/Status"},
        "response_ms":{"type":"integer","minimum":0},
        "last_checked":{"type":"string","format":"date-time"},
        "error":{"type":"string","maxLength":500}
      }
    },
    "Health": {
      "type":"object","additionalProperties":false,
      "required":["status","timestamp","services","infrastructure","healthy_count","total_count"],
      "properties":{
        "status":{"$ref":"#/$defs/Status"},
        "timestamp":{"type":"string","format":"date-time"},
        "services":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/Component"}},
        "infrastructure":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/Component"}},
        "healthy_count":{"type":"integer","minimum":0},
        "total_count":{"type":"integer","minimum":0}
      }
    },
    "Envelope": {
      "type":"object","additionalProperties":false,"required":["success","data"],
      "properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Health"}}
    }
  }
}
