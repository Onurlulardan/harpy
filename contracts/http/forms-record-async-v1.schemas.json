{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "UUIDv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "SHA256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "IdempotencyKey":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"},
    "FormIDParameter":{"name":"form_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "ExportIDParameter":{"name":"export_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "SourceIDParameter":{"name":"source_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "ImportIDParameter":{"name":"import_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantIDParameter":{"name":"X-Tenant-ID","in":"header","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantSlugParameter":{"name":"X-Tenant-Slug","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":100}},
    "IdempotencyKeyParameter":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"$ref":"#/$defs/IdempotencyKey"}},
    "AfterRowParameter":{"name":"after_row","in":"query","required":false,"schema":{"type":"integer","minimum":0,"maximum":1000000,"default":0}},
    "AfterImportParameter":{"name":"after","in":"query","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "LimitParameter":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},
    "ExportSubmitRequest":{"type":"object","additionalProperties":false,"required":["format","query"],"properties":{"format":{"enum":["csv","jsonl","xlsx"]},"query":{"type":"object","additionalProperties":false,"properties":{"select":{"type":"array","minItems":1,"maxItems":500,"uniqueItems":true,"items":{"type":"string"}},"where":{},"sort":{"type":"array"},"search":{}}}}},
    "ImportSubmitRequest":{"type":"object","additionalProperties":false,"required":["source_id","error_policy","mapping"],"properties":{"source_id":{"$ref":"#/$defs/UUIDv7"},"error_policy":{"enum":["fail_fast","collect_errors"]},"mapping":{"type":"object","required":["contract","fields"],"properties":{"contract":{"const":"forms-record-import-mapping.v2"},"fields":{"type":"array","minItems":1,"maxItems":500}}}}},
    "Export":{"type":"object","required":["export_id","job_id","receipt_id","form_id","form_version_id","state","cancellation_requested","format","selected_fields","created_at","replay"],"properties":{"export_id":{"$ref":"#/$defs/UUIDv7"},"job_id":{"$ref":"#/$defs/UUIDv7"},"receipt_id":{"$ref":"#/$defs/UUIDv7"},"form_id":{"$ref":"#/$defs/UUIDv7"},"form_version_id":{"$ref":"#/$defs/UUIDv7"},"state":{"enum":["queued","running","failed","cancelled","ready","expired"]},"cancellation_requested":{"type":"boolean"},"format":{"enum":["csv","jsonl","xlsx"]},"selected_fields":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"string"}},"ready_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"expires_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"created_at":{"type":"string","format":"date-time"},"replay":{"type":"boolean"}}},
    "Import":{"type":"object","required":["import_id","job_id","receipt_id","form_id","form_version_id","source_id","state","cancellation_requested","processed_rows","succeeded_rows","rejected_rows","created_at","replay"],"properties":{"import_id":{"$ref":"#/$defs/UUIDv7"},"job_id":{"$ref":"#/$defs/UUIDv7"},"receipt_id":{"$ref":"#/$defs/UUIDv7"},"form_id":{"$ref":"#/$defs/UUIDv7"},"form_version_id":{"$ref":"#/$defs/UUIDv7"},"source_id":{"$ref":"#/$defs/UUIDv7"},"state":{"enum":["queued","running","failed","cancelled","completed","completed_with_errors","stopped"]},"cancellation_requested":{"type":"boolean"},"processed_rows":{"type":"integer","minimum":0,"maximum":1000000},"succeeded_rows":{"type":"integer","minimum":0,"maximum":1000000},"rejected_rows":{"type":"integer","minimum":0,"maximum":10000},"created_at":{"type":"string","format":"date-time"},"completed_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"replay":{"type":"boolean"}}},
    "ImportPage":{"type":"object","additionalProperties":false,"required":["items","next"],"properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Import"}},"next":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]}}},
    "Source":{"type":"object","required":["source_id","format","plaintext_bytes","sha256","uploaded_at","replay"],"properties":{"source_id":{"$ref":"#/$defs/UUIDv7"},"format":{"enum":["csv","jsonl"]},"plaintext_bytes":{"type":"integer","minimum":1,"maximum":536870912},"sha256":{"$ref":"#/$defs/SHA256"},"uploaded_at":{"type":"string","format":"date-time"},"replay":{"type":"boolean"}}},
    "Analysis":{"type":"object","required":["source_id","format","rows","columns","samples"],"properties":{"source_id":{"$ref":"#/$defs/UUIDv7"},"format":{"enum":["csv","jsonl"]},"rows":{"type":"integer","minimum":0,"maximum":1000000},"columns":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["name","kind"],"properties":{"name":{"type":"string"},"kind":{"enum":["null","string","number","boolean","array","object","mixed"]}}}},"samples":{"type":"array","maxItems":5,"items":{"type":"object"}}}},
    "ErrorPage":{"type":"object","required":["items","next_after_row"],"properties":{"items":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["row_index","code","sha256"],"properties":{"row_index":{"type":"integer","minimum":1,"maximum":1000000},"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"},"sha256":{"$ref":"#/$defs/SHA256"}}}},"next_after_row":{"anyOf":[{"type":"integer","minimum":1,"maximum":1000000},{"type":"null"}]}}},
    "Control":{"type":"object","required":["action","state","cancellation_requested","changed"],"properties":{"action":{"type":"string"},"state":{"type":"string"},"cancellation_requested":{"type":"boolean"},"changed":{"type":"boolean"}}},
    "ExportEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Export"}}},
    "ImportEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Import"}}},
    "ImportPageEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/ImportPage"}}},
    "SourceEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Source"}}},
    "AnalysisEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Analysis"}}},
    "ErrorPageEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/ErrorPage"}}},
    "ControlEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Control"}}},
    "ErrorResponse":{"description":"Fail-closed error","content":{"application/json":{"schema":{"$ref":"core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
