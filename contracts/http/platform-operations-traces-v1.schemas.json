{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "CorrelationID":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "SpanID":{"type":"string","pattern":"^[0-9a-f]{16,32}$"},
    "Span":{
      "type":"object","additionalProperties":false,
      "required":["id","correlation_id","span_id","service_name","operation","span_kind","start_time","end_time","duration_ms","level","created_at"],
      "properties":{
        "id":{"$ref":"#/$defs/SpanID"},"correlation_id":{"$ref":"#/$defs/CorrelationID"},
        "span_id":{"$ref":"#/$defs/SpanID"},"parent_span_id":{"$ref":"#/$defs/SpanID"},
        "service_name":{"type":"string","minLength":1,"maxLength":100},
        "operation":{"type":"string","minLength":1,"maxLength":256},
        "span_kind":{"enum":["server","client","internal","consumer","producer"]},
        "method":{"enum":["GET","HEAD","POST","PUT","PATCH","DELETE","OPTIONS"]},
        "path":{"type":"string","pattern":"^/","maxLength":256},
        "status_code":{"type":"integer","minimum":100,"maximum":599},
        "start_time":{"type":"string","format":"date-time"},"end_time":{"type":"string","format":"date-time"},
        "duration_ms":{"type":"number","minimum":0},"level":{"enum":["debug","info","warn","error","fatal"]},
        "message":{"type":"string","maxLength":500},"created_at":{"type":"string","format":"date-time"}
      }
    },
    "Summary":{
      "type":"object","additionalProperties":false,
      "required":["correlation_id","first_span","last_span","total_duration_ms","span_count","services","root_operation","has_errors"],
      "properties":{
        "correlation_id":{"$ref":"#/$defs/CorrelationID"},"first_span":{"type":"string","format":"date-time"},
        "last_span":{"type":"string","format":"date-time"},"total_duration_ms":{"type":"number","minimum":0},
        "span_count":{"type":"integer","minimum":1},"services":{"type":"array","items":{"type":"string"},"maxItems":64},
        "root_operation":{"type":"string"},"root_status_code":{"type":"integer","minimum":100,"maximum":599},"has_errors":{"type":"boolean"}
      }
    },
    "Page":{
      "type":"object","additionalProperties":false,"required":["traces","total","page","limit","total_pages"],
      "properties":{"traces":{"type":"array","items":{"$ref":"#/$defs/Summary"}},"total":{"type":"integer","minimum":0},"page":{"type":"integer","minimum":1},"limit":{"type":"integer","minimum":1,"maximum":100},"total_pages":{"type":"integer","minimum":0}}
    },
    "Tree":{
      "type":"object","additionalProperties":false,"required":["span_id","service_name","operation","span_kind","duration_ms","level","has_error","children"],
      "properties":{"span_id":{"$ref":"#/$defs/SpanID"},"service_name":{"type":"string"},"operation":{"type":"string"},"span_kind":{"type":"string"},"duration_ms":{"type":"number","minimum":0},"status_code":{"type":"integer"},"level":{"type":"string"},"has_error":{"type":"boolean"},"start_offset_ms":{"type":"number"},"children":{"type":"array","items":{"$ref":"#/$defs/Tree"}}}
    },
    "Detail":{"type":"object","additionalProperties":false,"required":["correlation_id","spans","tree","total_spans","total_duration_ms"],"properties":{"correlation_id":{"$ref":"#/$defs/CorrelationID"},"spans":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Span"}},"tree":{"$ref":"#/$defs/Tree"},"total_spans":{"type":"integer","minimum":1},"total_duration_ms":{"type":"number","minimum":0}}},
    "TimelineItem":{"type":"object","additionalProperties":false,"required":["span_id","service_name","operation","span_kind","start_offset_ms","duration_ms","level","has_error"],"properties":{"span_id":{"$ref":"#/$defs/SpanID"},"parent_span_id":{"$ref":"#/$defs/SpanID"},"service_name":{"type":"string"},"operation":{"type":"string"},"span_kind":{"type":"string"},"start_offset_ms":{"type":"number"},"duration_ms":{"type":"number","minimum":0},"level":{"type":"string"},"status_code":{"type":"integer"},"has_error":{"type":"boolean"}}},
    "Timeline":{"type":"object","additionalProperties":false,"required":["correlation_id","base_time","timeline"],"properties":{"correlation_id":{"$ref":"#/$defs/CorrelationID"},"base_time":{"type":"string","format":"date-time"},"timeline":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/TimelineItem"}}}},
    "EndpointStats":{"type":"object","additionalProperties":false,"required":["path","method","avg_duration_ms","call_count","error_count"],"properties":{"path":{"type":"string"},"method":{"type":"string"},"avg_duration_ms":{"type":"number","minimum":0},"call_count":{"type":"integer","minimum":0},"error_count":{"type":"integer","minimum":0}}},
    "Stats":{"type":"object","additionalProperties":false,"required":["total_traces","total_spans","error_rate","avg_duration_ms","spans_by_service","spans_by_level","traces_last_24h","traces_last_hour","slowest_endpoints"],"properties":{"total_traces":{"type":"integer","minimum":0},"total_spans":{"type":"integer","minimum":0},"error_rate":{"type":"number","minimum":0,"maximum":100},"avg_duration_ms":{"type":"number","minimum":0},"spans_by_service":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"spans_by_level":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"traces_last_24h":{"type":"integer","minimum":0},"traces_last_hour":{"type":"integer","minimum":0},"slowest_endpoints":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/EndpointStats"}}}},
    "PageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Page"}}},
    "SpanEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Span"}}},
    "DetailEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Detail"}}},
    "TimelineEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Timeline"}}},
    "StatsEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Stats"}}}
  }
}
