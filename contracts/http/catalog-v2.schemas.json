{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "UUIDv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "StableUUID":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","not":{"const":"00000000-0000-0000-0000-000000000000"}},
    "SHA256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "SemVer":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
    "Slug":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"},
    "IdempotencyKey":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"},
    "TenantIDParameter":{"name":"X-Tenant-ID","in":"header","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantSlugParameter":{"name":"X-Tenant-Slug","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":100}},
    "IdempotencyKeyParameter":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"$ref":"#/$defs/IdempotencyKey"}},
    "PackageIDParameter":{"name":"package_id","in":"path","required":true,"schema":{"$ref":"#/$defs/StableUUID"}},
    "VersionParameter":{"name":"version","in":"path","required":true,"schema":{"$ref":"#/$defs/SemVer"}},
    "InstallationIDParameter":{"name":"installation_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "OperationIDParameter":{"name":"operation_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "MenuItemIDParameter":{"name":"item_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "LimitParameter":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},
    "AfterParameter":{"name":"after","in":"query","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "PackageAfterParameter":{"name":"after","in":"query","required":false,"schema":{"$ref":"#/$defs/StableUUID"}},
    "Package":{"type":"object","additionalProperties":false,"required":["package_id","slug","created_at"],"properties":{"package_id":{"$ref":"#/$defs/StableUUID"},"slug":{"$ref":"#/$defs/Slug"},"created_at":{"type":"string","format":"date-time"}}},
    "PackageVersion":{"type":"object","additionalProperties":false,"required":["package_id","slug","version","manifest_sha256","key_id","registered_at"],"properties":{"package_id":{"$ref":"#/$defs/StableUUID"},"slug":{"$ref":"#/$defs/Slug"},"version":{"$ref":"#/$defs/SemVer"},"manifest_sha256":{"$ref":"#/$defs/SHA256"},"key_id":{"type":"string","minLength":1,"maxLength":128},"registered_at":{"type":"string","format":"date-time"}}},
    "Installation":{"type":"object","additionalProperties":false,"required":["installation_id","package_id","active_version","state","reference_epoch","revision","last_operation_id"],"properties":{"installation_id":{"$ref":"#/$defs/UUIDv7"},"package_id":{"$ref":"#/$defs/StableUUID"},"active_version":{"anyOf":[{"$ref":"#/$defs/SemVer"},{"type":"null"}]},"state":{"enum":["INSTALLING","ACTIVE","DISABLED","INSTALL_FAILED","RETIRED","PURGE_PENDING","PURGED"]},"reference_epoch":{"type":"integer","minimum":1},"revision":{"type":"integer","minimum":1},"last_operation_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]}}},
    "Operation":{"type":"object","additionalProperties":false,"required":["operation_id","kind","state","plan_sha256","started_at","failure_code","revision","replayed"],"properties":{"operation_id":{"$ref":"#/$defs/UUIDv7"},"kind":{"enum":["INSTALL","UPGRADE","RETRY","RESTORE","RETIRE","PURGE","DEMO_INSTALL","DEMO_REMOVE"]},"state":{"enum":["PLANNED","APPLYING","WAITING","VERIFYING","ACTIVATING","CANCELLING","SUCCEEDED","BLOCKED","FAILED","CANCELLED"]},"plan_sha256":{"$ref":"#/$defs/SHA256"},"started_at":{"type":"string","format":"date-time"},"failure_code":{"type":"string","maxLength":128},"revision":{"type":"integer","minimum":1},"replayed":{"type":"boolean"}}},
    "DemoComponentStatus":{"type":"object","additionalProperties":false,"required":["component_id","source_run_id","record_count"],"properties":{"component_id":{"$ref":"#/$defs/UUIDv7"},"source_run_id":{"$ref":"#/$defs/UUIDv7"},"record_count":{"type":"integer","minimum":0,"maximum":10000}}},
    "DemoStatus":{"type":"object","additionalProperties":false,"required":["installation_id","state","components","updated_at"],"properties":{"installation_id":{"$ref":"#/$defs/UUIDv7"},"state":{"enum":["NOT_INCLUDED","INSTALLED","ABSENT"]},"components":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/DemoComponentStatus"}},"updated_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]}}},
    "DemoRemovalComponent":{"type":"object","additionalProperties":false,"required":["component_id","source_run_id","record_ids"],"properties":{"component_id":{"$ref":"#/$defs/UUIDv7"},"source_run_id":{"$ref":"#/$defs/UUIDv7"},"record_ids":{"type":"array","minItems":1,"maxItems":10000,"uniqueItems":true,"items":{"$ref":"#/$defs/StableUUID"}}}},
    "DemoRemovalPlan":{"type":"object","additionalProperties":false,"required":["installation_id","components","record_count","plan_sha256"],"properties":{"installation_id":{"$ref":"#/$defs/UUIDv7"},"components":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/DemoRemovalComponent"}},"record_count":{"type":"integer","minimum":1,"maximum":10000},"plan_sha256":{"$ref":"#/$defs/SHA256"}}},
    "DemoRemoveRequest":{"type":"object","additionalProperties":false,"required":["expected_plan_sha256"],"properties":{"expected_plan_sha256":{"$ref":"#/$defs/SHA256"}}},
    "MenuItem":{"type":"object","additionalProperties":false,"required":["item_id","package_id","parent_id","order","kind","label","target_id","visible"],"properties":{"item_id":{"$ref":"#/$defs/UUIDv7"},"package_id":{"$ref":"#/$defs/StableUUID"},"parent_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"order":{"type":"integer","minimum":0,"maximum":100000},"kind":{"enum":["GROUP","FORM","WORKFLOW","DASHBOARD","ENDPOINT","EXTERNAL_LINK"]},"label":{"type":"string","minLength":1,"maxLength":128},"target_id":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]},"visible":{"type":"boolean"}}},
    "InstallRequest":{"type":"object","additionalProperties":false,"required":["package_id","version"],"properties":{"package_id":{"$ref":"#/$defs/StableUUID"},"version":{"$ref":"#/$defs/SemVer"}}},
    "UpgradeRequest":{"type":"object","additionalProperties":false,"required":["version"],"properties":{"version":{"$ref":"#/$defs/SemVer"}}},
    "PurgeSlug":{"type":"string","minLength":2,"maxLength":63,"pattern":"^[a-z][a-z0-9-]{1,62}$"},
    "PurgeRequest":{"type":"object","additionalProperties":false,"required":["operation_id","backup_receipt_id","approval_receipt_id","reason","confirmation_slug"],"properties":{"operation_id":{"$ref":"#/$defs/UUIDv7"},"backup_receipt_id":{"$ref":"#/$defs/UUIDv7"},"approval_receipt_id":{"$ref":"#/$defs/UUIDv7"},"reason":{"type":"string","minLength":1,"maxLength":512},"confirmation_slug":{"$ref":"#/$defs/PurgeSlug"}}},
    "PurgeApprovalRequest":{"type":"object","additionalProperties":false,"required":["operation_id","backup_receipt_id","requested_by","reason","confirmation_slug","purge_idempotency_key"],"properties":{"operation_id":{"$ref":"#/$defs/UUIDv7"},"backup_receipt_id":{"$ref":"#/$defs/UUIDv7"},"requested_by":{"$ref":"#/$defs/UUIDv7"},"reason":{"type":"string","minLength":1,"maxLength":512},"confirmation_slug":{"$ref":"#/$defs/PurgeSlug"},"purge_idempotency_key":{"$ref":"#/$defs/IdempotencyKey"}}},
    "PurgeApproval":{"type":"object","additionalProperties":false,"required":["approval_receipt_id","operation_id","requested_by","approved_by","approval_sha256","approved_at","expires_at","replayed"],"properties":{"approval_receipt_id":{"$ref":"#/$defs/UUIDv7"},"operation_id":{"$ref":"#/$defs/UUIDv7"},"requested_by":{"$ref":"#/$defs/UUIDv7"},"approved_by":{"$ref":"#/$defs/UUIDv7"},"approval_sha256":{"$ref":"#/$defs/SHA256"},"approved_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"replayed":{"type":"boolean"}}},
    "MenuOverrideRequest":{"type":"object","additionalProperties":false,"required":["expected_revision"],"minProperties":2,"properties":{"expected_revision":{"type":"integer","minimum":1},"label":{"type":"string","minLength":1,"maxLength":128},"order":{"type":"integer","minimum":0,"maximum":100000},"visible":{"type":"boolean"}}},
    "PackageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Package"}}},
    "PackageVersionEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/PackageVersion"}}},
    "PackagePageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["items","next"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/Package"}},"next":{"anyOf":[{"$ref":"#/$defs/StableUUID"},{"type":"null"}]}}}}},
    "PackageVersionPageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["items"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/PackageVersion"}}}}}},
    "InstallationEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Installation"}}},
    "InstallationPageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["items","next"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/Installation"}},"next":{"anyOf":[{"$ref":"#/$defs/UUIDv7"},{"type":"null"}]}}}}},
    "OperationEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Operation"}}},
    "DemoStatusEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/DemoStatus"}}},
    "DemoRemovalPlanEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/DemoRemovalPlan"}}},
    "PurgeApprovalEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/PurgeApproval"}}},
    "MenuEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["version_id","number","revision","items"],"properties":{"version_id":{"$ref":"#/$defs/UUIDv7"},"number":{"type":"integer","minimum":1},"revision":{"type":"integer","minimum":1},"items":{"type":"array","maxItems":2048,"items":{"$ref":"#/$defs/MenuItem"}}}}}},
    "MenuOverrideReceiptEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["item_id","revision","replayed"],"properties":{"item_id":{"$ref":"#/$defs/UUIDv7"},"revision":{"type":"integer","minimum":1},"replayed":{"type":"boolean"}}}}},
    "ErrorResponse":{"description":"Fail-closed error","content":{"application/json":{"schema":{"$ref":"core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
