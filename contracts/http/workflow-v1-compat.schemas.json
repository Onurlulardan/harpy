{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://harpy.io/contracts/http/workflow-v1-compat.schemas.json",
  "$defs":{
    "LegacyWorkflowID":{"type":"string","format":"uuid"},
    "LegacyTaskID":{"type":"string","format":"uuid"},
    "LegacyWorkflowIDParameter":{"name":"workflow_id","in":"path","required":true,"schema":{"$ref":"#/$defs/LegacyWorkflowID"}},
    "LegacyTaskIDParameter":{"name":"task_id","in":"path","required":true,"schema":{"$ref":"#/$defs/LegacyTaskID"}},
    "LegacyDefinitionRequest":{
      "type":"object","additionalProperties":false,
      "required":["name","description","is_active","trigger_type","trigger_config","nodes","edges"],
      "properties":{
        "name":{"type":"string","minLength":1,"maxLength":200},
        "description":{"type":"string","maxLength":2000},
        "is_active":{"type":"boolean"},
        "trigger_type":{"enum":["FORM_TRIGGER","SCHEDULE_TRIGGER","WEBHOOK_TRIGGER"]},
        "trigger_config":{"type":"object"},
        "nodes":{"type":"array","maxItems":200},
        "edges":{"type":"array","maxItems":500}
      }
    },
    "LegacyFlowData":{
      "type":"object","additionalProperties":false,"required":["nodes","edges"],
      "properties":{"nodes":{"type":"array"},"edges":{"type":"array"}}
    },
    "LegacyVersion":{
      "type":"object","additionalProperties":false,
      "required":["id","tenant_id","workflow_id","version","flow_data","is_published","created_at"],
      "properties":{
        "id":{"type":"string","format":"uuid"},"tenant_id":{"type":"string","format":"uuid"},
        "workflow_id":{"type":"string","format":"uuid"},"version":{"type":"integer","minimum":1},
        "flow_data":{"$ref":"#/$defs/LegacyFlowData"},"is_published":{"type":"boolean"},
        "created_at":{"type":"string","format":"date-time"}
      }
    },
    "LegacyDefinition":{
      "type":"object","additionalProperties":false,
      "required":["id","tenant_id","tenant_slug","name","description","is_active","is_system","trigger_type","trigger_config","created_at","updated_at"],
      "properties":{
        "id":{"type":"string","format":"uuid"},"tenant_id":{"type":"string","format":"uuid"},
        "tenant_slug":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},
        "is_active":{"type":"boolean"},"is_system":{"type":"boolean"},"trigger_type":{"type":"string"},
        "trigger_config":{"type":"object"},"nodes":{"type":"array"},"edges":{"type":"array"},
        "versions":{"type":"array","items":{"$ref":"#/$defs/LegacyVersion"},"maxItems":1},
        "created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}
      }
    },
    "LegacyDefinitionList":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/LegacyDefinition"}},
    "LegacyTaskActionRequest":{
      "type":"object","additionalProperties":false,"required":["action","note"],
      "properties":{"action":{"enum":["APPROVE","REJECT","REVISION"]},"note":{"type":"string","maxLength":2000}}
    },
    "LegacyTaskListEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object"}}},
    "LegacyTaskEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object"}}},
    "LegacyDeleteEnvelope":{"type":"object","required":["success","message","meta"],"properties":{"success":{"const":true},"message":{"const":"Operation completed successfully"},"meta":{"type":"object"}}},
    "ErrorResponse":{"description":"Stable compatibility error","content":{"application/json":{"schema":{"$ref":"core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
