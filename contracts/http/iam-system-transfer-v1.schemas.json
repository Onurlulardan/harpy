{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "UUIDv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "SHA256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Resource":{"enum":["users","roles","organizations"]},
    "IdempotencyKey":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"},
    "ResourceParameter":{"name":"resource","in":"path","required":true,"schema":{"$ref":"#/$defs/Resource"}},
    "ExportIDParameter":{"name":"export_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "ImportIDParameter":{"name":"import_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantIDParameter":{"name":"X-Tenant-ID","in":"header","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantSlugParameter":{"name":"X-Tenant-Slug","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":100}},
    "IdempotencyKeyParameter":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"$ref":"#/$defs/IdempotencyKey"}},
    "AfterRowParameter":{"name":"after_row","in":"query","required":false,"schema":{"type":"integer","minimum":0,"maximum":1000000,"default":0}},
    "LimitParameter":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},
    "ExportQuery":{"type":"object","additionalProperties":false,"properties":{"select":{"type":"array","minItems":1,"maxItems":50,"uniqueItems":true,"items":{"type":"string"}},"where":{},"sort":{"type":"array","maxItems":4},"search":{}}},
    "ExportSubmitRequest":{"type":"object","additionalProperties":false,"required":["format","query"],"properties":{"format":{"enum":["csv","jsonl","xlsx"]},"query":{"$ref":"#/$defs/ExportQuery"}}},
    "MappingExpression":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","source"],"properties":{"kind":{"const":"direct"},"source":{"type":"string"}}},{"type":"object","additionalProperties":false,"required":["kind","sources","separator"],"properties":{"kind":{"const":"concat"},"sources":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string"}},"separator":{"type":"string"}}},{"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"const":"static"},"value":{}}},{"type":"object","additionalProperties":false,"required":["kind","ast"],"properties":{"kind":{"const":"formula_numeric"},"ast":{"type":"object"}}}]},
    "Mapping":{"type":"object","additionalProperties":false,"required":["contract","fields"],"properties":{"contract":{"const":"tabular-mapping.v2"},"fields":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["target","required","expression"],"properties":{"target":{"type":"string","format":"uuid"},"required":{"type":"boolean"},"expression":{"$ref":"#/$defs/MappingExpression"}}}}}},
    "ImportSubmitRequest":{"type":"object","additionalProperties":false,"required":["source_id","duplicate_action","mapping"],"properties":{"source_id":{"$ref":"#/$defs/UUIDv7"},"duplicate_action":{"enum":["skip","update"]},"mapping":{"$ref":"#/$defs/Mapping"}}},
    "Export":{"type":"object","additionalProperties":false,"required":["export_id","resource","format","state","rows","bytes","created_at","replay"],"properties":{"export_id":{"$ref":"#/$defs/UUIDv7"},"resource":{"$ref":"#/$defs/Resource"},"format":{"enum":["csv","jsonl","xlsx"]},"state":{"enum":["waiting","running","failed","cancelled","ready","expired"]},"rows":{"type":"integer","minimum":0,"maximum":1000000},"bytes":{"type":"integer","minimum":0,"maximum":2147483648},"created_at":{"type":"string","format":"date-time"},"ready_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"expires_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"replay":{"type":"boolean"}}},
    "SourceColumn":{"type":"object","additionalProperties":false,"required":["name","kind"],"properties":{"name":{"type":"string","minLength":1,"maxLength":256},"kind":{"enum":["null","string","number","boolean","array","object","mixed"]}}},
    "Source":{"type":"object","additionalProperties":false,"required":["source_id","resource","format","bytes","sha256","uploaded_at","replay","columns","samples"],"properties":{"source_id":{"$ref":"#/$defs/UUIDv7"},"resource":{"$ref":"#/$defs/Resource"},"format":{"enum":["csv","jsonl"]},"bytes":{"type":"integer","minimum":1,"maximum":536870912},"sha256":{"$ref":"#/$defs/SHA256"},"uploaded_at":{"type":"string","format":"date-time"},"replay":{"type":"boolean"},"columns":{"type":"array","minItems":1,"maxItems":500,"items":{"$ref":"#/$defs/SourceColumn"}},"samples":{"type":"array","maxItems":5,"items":{"type":"object","maxProperties":500}}}},
    "Import":{"type":"object","additionalProperties":false,"required":["import_id","resource","state","rows_seen","created","updated","skipped","failed","created_at","replay"],"properties":{"import_id":{"$ref":"#/$defs/UUIDv7"},"resource":{"$ref":"#/$defs/Resource"},"state":{"enum":["waiting","running","completed","cancelled","failed"]},"rows_seen":{"type":"integer","minimum":0,"maximum":1000000},"created":{"type":"integer","minimum":0},"updated":{"type":"integer","minimum":0},"skipped":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0,"maximum":10000},"created_at":{"type":"string","format":"date-time"},"completed_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"replay":{"type":"boolean"}}},
    "Receipt":{"type":"object","additionalProperties":false,"required":["row_index","outcome","source_digest","result_digest"],"properties":{"row_index":{"type":"integer","minimum":1,"maximum":1000000},"outcome":{"enum":["created","updated","skipped","rejected"]},"owner_kind":{"enum":["record","invitation"]},"owner_id":{"type":"string","format":"uuid"},"error_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"},"source_digest":{"$ref":"#/$defs/SHA256"},"result_digest":{"$ref":"#/$defs/SHA256"}}},
    "Report":{"type":"object","additionalProperties":false,"required":["import_id","receipts","next_after_row","has_more"],"properties":{"import_id":{"$ref":"#/$defs/UUIDv7"},"receipts":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/Receipt"}},"next_after_row":{"type":"integer","minimum":0,"maximum":1000000},"has_more":{"type":"boolean"}}},
    "ExportEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Export"}}},
    "SourceEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Source"}}},
    "ImportEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Import"}}},
    "ReportEnvelope":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Report"}}},
    "ErrorResponse":{"description":"Fail-closed error","content":{"application/json":{"schema":{"$ref":"core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
