{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "Channel":{"type":"object","additionalProperties":false,"required":["channel_type","config","enabled"],"properties":{"id":{"type":"string","format":"uuid"},"alert_config_id":{"type":"string","format":"uuid"},"channel_type":{"enum":["email","telegram"]},"config":{"type":"object","maxProperties":0},"enabled":{"type":"boolean"}}},
    "RuleInput":{"type":"object","additionalProperties":false,"required":["name","description","enabled","service_name","condition","cooldown_minutes","channels"],"properties":{"name":{"type":"string","minLength":1,"maxLength":120},"description":{"type":"string","maxLength":1000},"enabled":{"type":"boolean"},"service_name":{"type":["string","null"],"minLength":1,"maxLength":100},"condition":{"enum":["unhealthy","degraded","any_change"]},"cooldown_minutes":{"type":"integer","minimum":1,"maximum":10080},"channels":{"type":"array","maxItems":2,"items":{"$ref":"#/$defs/Channel"}}}},
    "Rule":{"type":"object","additionalProperties":false,"required":["id","name","description","enabled","service_name","condition","cooldown_minutes","channels","created_at","updated_at"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string","minLength":1,"maxLength":120},"description":{"type":"string","maxLength":1000},"enabled":{"type":"boolean"},"service_name":{"type":["string","null"],"minLength":1,"maxLength":100},"condition":{"enum":["unhealthy","degraded","any_change"]},"cooldown_minutes":{"type":"integer","minimum":1,"maximum":10080},"channels":{"type":"array","maxItems":2,"items":{"$ref":"#/$defs/Channel"}},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
    "Event":{"type":"object","additionalProperties":false,"required":["id","alert_config_id","service_name","previous_status","current_status","channels_used","message","resolved_at","created_at"],"properties":{"id":{"type":"string","format":"uuid"},"alert_config_id":{"type":["string","null"],"format":"uuid"},"service_name":{"type":"string","minLength":1,"maxLength":100},"previous_status":{"enum":["healthy","degraded","unhealthy","unknown"]},"current_status":{"enum":["healthy","degraded","unhealthy","unknown"]},"channels_used":{"type":"array","uniqueItems":true,"items":{"enum":["email","telegram"]}},"message":{"type":"string","minLength":1,"maxLength":1000},"resolved_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"}}},
    "RulesEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"array","items":{"$ref":"#/$defs/Rule"}}}},
    "RuleEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Rule"}}},
    "EventEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Event"}}},
    "EventsEnvelope":{"type":"object","additionalProperties":false,"required":["success","data","meta"],"properties":{"success":{"const":true},"data":{"type":"array","items":{"$ref":"#/$defs/Event"}},"meta":{"type":"object","additionalProperties":false,"required":["total","page","limit","total_pages"],"properties":{"total":{"type":"integer","minimum":0},"page":{"type":"integer","minimum":1},"limit":{"type":"integer","minimum":1,"maximum":100},"total_pages":{"type":"integer","minimum":0}}}}}
  }
