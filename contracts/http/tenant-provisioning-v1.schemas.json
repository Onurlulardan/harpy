{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "ProvisionRequest":{"type":"object","additionalProperties":false,"required":["name","slug","first_admin"],"properties":{"name":{"type":"string","minLength":1,"maxLength":128},"slug":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$"},"first_admin":{"type":"object","additionalProperties":false,"required":["display_name","email"],"properties":{"display_name":{"type":"string","minLength":1,"maxLength":128},"email":{"type":"string","format":"email","maxLength":254}}}}},
    "AcceptedEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["operation_id","location"],"properties":{"operation_id":{"type":"string","format":"uuid"},"location":{"type":"string","pattern":"^/api/platform/tenant-provisioning-operations/[0-9a-f-]{36}$"}}}}},
    "Failure":{"type":"object","additionalProperties":false,"required":["code","retryable","correlation_id"],"properties":{"code":{"type":"string","minLength":1},"retryable":{"type":"boolean"},"correlation_id":{"type":"string","format":"uuid"}}},
    "Operation":{"type":"object","additionalProperties":false,"required":["operation_id","state","admin_setup_delivery_state","created_at","updated_at"],"properties":{"operation_id":{"type":"string","format":"uuid"},"state":{"enum":["accepted","migrating","awaiting_authority_ack","finalizing","succeeded","failed"]},"tenant_id":{"type":"string","format":"uuid"},"admin_setup_delivery_state":{"enum":["pending","delivered","outcome_unknown","permanent_failure","accepted","reissued","revoked"]},"failure":{"$ref":"#/$defs/Failure"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"oneOf":[{"properties":{"state":{"const":"succeeded"}},"required":["tenant_id"],"not":{"required":["failure"]}},{"properties":{"state":{"const":"failed"}},"required":["failure"],"not":{"required":["tenant_id"]}},{"properties":{"state":{"enum":["accepted","migrating","awaiting_authority_ack","finalizing"]}},"not":{"anyOf":[{"required":["tenant_id"]},{"required":["failure"]}]}}]},
    "OperationEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Operation"}}}
  }
}
