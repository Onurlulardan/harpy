{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "UUIDv7":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "StableUUID":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "SHA256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Resource":{"enum":["users","roles","organizations"]},
    "TenantIDParameter":{"name":"X-Tenant-ID","in":"header","required":false,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "TenantSlugParameter":{"name":"X-Tenant-Slug","in":"header","required":false,"schema":{"type":"string","minLength":1,"maxLength":100}},
    "ResourceParameter":{"name":"resource","in":"path","required":true,"schema":{"$ref":"#/$defs/Resource"}},
    "RevisionIDParameter":{"name":"revision_id","in":"path","required":true,"schema":{"$ref":"#/$defs/UUIDv7"}},
    "IfMatchParameter":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string","pattern":"^\"layout-row-revision-[1-9][0-9]*\"$"}},
    "ETagHeader":{"description":"Exact current row revision","schema":{"type":"string","pattern":"^\"layout-row-revision-[1-9][0-9]*\"$"}},
    "PresentationETagHeader":{"description":"SHA-256 of the resolved presentation","schema":{"type":"string","pattern":"^\"presentation-[0-9a-f]{64}\"$"}},
    "LocationHeader":{"description":"Canonical resource URI","schema":{"type":"string","pattern":"^/api/system-resources/(users|roles|organizations)/layout-revisions/[0-9a-f-]+(/publication)?$"}},
    "Translation":{"type":"object","additionalProperties":false,"required":["locale","label","help"],"properties":{"locale":{"type":"string","minLength":2,"maxLength":35},"label":{"type":"string","minLength":1,"maxLength":200},"help":{"type":"string","maxLength":1000}}},
    "Field":{"type":"object","additionalProperties":false,"required":["field_id","interaction","order","translations","widget"],"properties":{"field_id":{"$ref":"#/$defs/StableUUID"},"interaction":{"enum":["auto","read_only","disabled"]},"order":{"type":"integer","minimum":0},"translations":{"type":"array","items":{"$ref":"#/$defs/Translation"}},"widget":{"enum":["auto","checkbox","date","datetime","document_selector","document_uploader","email","json","lookup","multi_select","number","password","radio","select","telephone","text","textarea","time","toggle","url"]}}},
    "Section":{"type":"object","additionalProperties":false,"required":["id","order","translations","fields"],"properties":{"id":{"$ref":"#/$defs/StableUUID"},"order":{"type":"integer","minimum":0},"translations":{"type":"array","items":{"$ref":"#/$defs/Translation"}},"fields":{"type":"array","items":{"$ref":"#/$defs/Field"}}}},
    "Surface":{"type":"object","additionalProperties":false,"required":["kind","translations","sections"],"properties":{"kind":{"enum":["record_create","record_update","record_detail","record_list","record_filter","print"]},"translations":{"type":"array","items":{"$ref":"#/$defs/Translation"}},"sections":{"type":"array","items":{"$ref":"#/$defs/Section"}}}},
    "ReadableDefinition":{"type":"object","additionalProperties":false,"required":["contract","surfaces"],"properties":{"contract":{"enum":["harpy/system-resource-layout/v1","harpy/system-resource-layout/v2"]},"surfaces":{"type":"array","minItems":4,"maxItems":6,"items":{"$ref":"#/$defs/Surface"}}}},
    "WritableDefinition":{"type":"object","additionalProperties":false,"required":["contract","surfaces"],"properties":{"contract":{"const":"harpy/system-resource-layout/v2"},"surfaces":{"type":"array","minItems":5,"maxItems":6,"items":{"$ref":"#/$defs/Surface"}}}},
    "DefinitionRequest":{"type":"object","additionalProperties":false,"required":["definition"],"properties":{"definition":{"$ref":"#/$defs/WritableDefinition"}}},
    "Revision":{"type":"object","additionalProperties":false,"required":["revision_id","resource","version","state","definition","definition_sha256","created_at","updated_at","published_at","row_revision"],"properties":{"revision_id":{"$ref":"#/$defs/StableUUID"},"resource":{"$ref":"#/$defs/Resource"},"version":{"type":"integer","minimum":1},"state":{"enum":["draft","published"]},"definition":{"$ref":"#/$defs/ReadableDefinition"},"definition_sha256":{"$ref":"#/$defs/SHA256"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"published_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"row_revision":{"type":"integer","minimum":1}}},
    "RevisionEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Revision"}}},
    "RevisionPageEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["items"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/Revision"}}}}}},
    "DeleteEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["revision_id","deleted"],"properties":{"revision_id":{"$ref":"#/$defs/UUIDv7"},"deleted":{"const":true}}}}},
    "PresentationNode":{"type":"object","additionalProperties":true,"required":["id","kind","span","translations"],"properties":{"id":{"$ref":"#/$defs/StableUUID"},"kind":{"type":"string"},"span":{"type":"integer","minimum":1},"translations":{"type":"array"},"children":{"type":"array","items":{"$ref":"#/$defs/PresentationNode"}}}},
    "Presentation":{"type":"object","additionalProperties":false,"required":["registry_contract","default_locale","locales","surfaces"],"properties":{"registry_contract":{"const":"forms-presentation-registry.v1"},"default_locale":{"type":"string"},"locales":{"type":"array","items":{"type":"string"}},"surfaces":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","kind","translations","root"],"properties":{"id":{"$ref":"#/$defs/StableUUID"},"kind":{"type":"string"},"translations":{"type":"array"},"root":{"$ref":"#/$defs/PresentationNode"}}}}}},
    "PresentationEnvelope":{"type":"object","additionalProperties":false,"required":["success","data"],"properties":{"success":{"const":true},"data":{"$ref":"#/$defs/Presentation"}}},
    "ErrorResponse":{"description":"Fail-closed error","content":{"application/json":{"schema":{"$ref":"core-api-v1.components.json#/schemas/ErrorEnvelope"}}}}
  }
}
