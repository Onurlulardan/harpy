        "responses": {"200": {"description": "Dashboard page", "content": {"application/json": {"schema": {"$ref": "analytics-dashboard-v2.schemas.json#/$defs/PageEnvelope"}}}}, "default": {"$ref": "analytics-common-v2.schemas.json#/$defs/ErrorResponse"}}
      },
