        "security": [{"bearerAuth": []}], "operationId": "setDefaultAnalyticsDashboard",
        "x-harpy-permission": "analytics.dashboard.read", "x-harpy-authority": "analytics.dashboard.set_default",
        "responses": {"200": {"description": "Principal surface preference updated", "content": {"application/json": {"schema": {"$ref": "analytics-dashboard-v2.schemas.json#/$defs/DefaultEnvelope"}}}}, "default": {"$ref": "analytics-common-v2.schemas.json#/$defs/ErrorResponse"}}
      }
