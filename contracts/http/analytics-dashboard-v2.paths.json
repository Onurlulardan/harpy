        "responses": {"201": {"description": "Immutable dashboard version published", "content": {"application/json": {"schema": {"$ref": "analytics-dashboard-v2.schemas.json#/$defs/Envelope"}}}}, "default": {"$ref": "analytics-common-v2.schemas.json#/$defs/ErrorResponse"}}
      }
    },
