{
  "schemas": {
    "UUID": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Role": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/schemas/UUID"}, "name": {"type": "string", "minLength": 1}}
    },
    "Organization": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "slug"],
      "properties": {
        "id": {"$ref": "#/schemas/UUID"},
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1}
      }
    },
    "SelfProfile": {
      "type": "object",
      "description": "Core identity fields plus active, non-restricted dynamic profile fields keyed by schema key.",
      "required": ["id", "email", "status", "revision", "created_at", "updated_at", "role_ids", "roles", "organization_ids", "organizations"],
      "properties": {
        "id": {"$ref": "#/schemas/UUID"},
        "email": {"type": "string", "format": "email", "minLength": 3, "maxLength": 254},
        "status": {"const": "ACTIVE"},
        "revision": {"type": "integer", "format": "int64", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "role_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/schemas/UUID"}},
        "roles": {"type": "array", "items": {"$ref": "#/schemas/Role"}},
        "organization_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/schemas/UUID"}},
        "organizations": {"type": "array", "items": {"$ref": "#/schemas/Organization"}},
        "organization_id": {"$ref": "#/schemas/UUID"},
        "organization": {"$ref": "#/schemas/Organization"}
      },
      "additionalProperties": true
    },
    "Validation": {
      "type": "object", "additionalProperties": false, "required": ["maximum_bytes"],
      "properties": {
        "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximum_items": {"type": "integer", "minimum": 1, "maximum": 1000},
        "integer_minimum": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)$"},
        "integer_maximum": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)$"},
        "decimal_precision": {"type": "integer", "minimum": 1, "maximum": 1000},
        "decimal_scale": {"type": "integer", "minimum": 0, "maximum": 1000},
        "enum_values": {"type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "Field": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "key", "type", "cardinality", "required", "classification", "normalization", "state", "validation", "validation_sha256", "semantic_sha256"],
      "properties": {
        "id": {"$ref": "#/schemas/UUID"},
        "key": {"type": "string", "minLength": 1, "maxLength": 63},
        "type": {"enum": ["string", "integer", "decimal", "boolean", "date", "timestamp", "uuid", "enum", "json"]},
        "cardinality": {"enum": ["single", "list"]},
        "required": {"type": "boolean"},
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "normalization": {"enum": ["none_v1", "email_v1", "portal_v1"]},
        "state": {"enum": ["active", "retired"]},
        "validation": {"$ref": "#/schemas/Validation"},
        "validation_sha256": {"$ref": "#/schemas/SHA256"},
        "semantic_sha256": {"$ref": "#/schemas/SHA256"}
      }
    },
    "Schema": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "resource", "version", "state", "fields", "definition", "definition_sha256"],
      "properties": {
        "id": {"$ref": "#/schemas/UUID"},
        "resource": {"enum": ["user", "role", "organization"]},
        "version": {"type": "integer", "format": "int64", "minimum": 1},
        "state": {"enum": ["active", "retired"]},
        "fields": {"type": "array", "items": {"$ref": "#/schemas/Field"}},
        "definition": {"type": "object"},
        "definition_sha256": {"$ref": "#/schemas/SHA256"}
      }
    },
    "Mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "authorization_clock", "replayed"],
      "properties": {
        "id": {"$ref": "#/schemas/UUID"},
        "revision": {"type": "integer", "format": "int64", "minimum": 1},
        "authorization_clock": {"type": "integer", "format": "int64", "minimum": 1},
        "replayed": {"type": "boolean"},
        "backfill_plan_id": {"$ref": "#/schemas/UUID", "description": "Durable IAM-owned plan when activation is pending."},
        "publication_state": {"enum": ["planned"], "description": "Target schema is a draft pending verified backfill activation."}
      }
    },
    "Recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "recovery_of_plan_id", "recovery_root_plan_id", "recovery_sequence", "revision", "authorization_clock", "state", "replayed"],
      "properties": {
        "plan_id": {"$ref": "#/schemas/UUID"},
        "recovery_of_plan_id": {"$ref": "#/schemas/UUID"},
        "recovery_root_plan_id": {"$ref": "#/schemas/UUID"},
        "recovery_sequence": {"type": "integer", "format": "int64", "minimum": 1},
        "revision": {"type": "integer", "format": "int64", "minimum": 1},
        "authorization_clock": {"type": "integer", "format": "int64", "minimum": 1},
        "state": {"enum": ["planned", "running", "activated", "fenced"]},
        "replayed": {"type": "boolean"}
      }
    }
  }
}
