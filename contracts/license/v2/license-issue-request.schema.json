{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/license/v2/license-issue-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "license_id", "licensee_organization_id", "environment_id", "deployment_mode", "delivery_kind", "nonce", "current_sequence", "current_digest", "component_versions"],
  "properties": {
    "schema": {"const": "harpy-license-issue-request.v2"},
    "operation_id": {"$ref": "#/$defs/uuid"},
    "license_id": {"$ref": "#/$defs/uuid"},
    "licensee_organization_id": {"$ref": "#/$defs/uuid"},
    "environment_id": {"$ref": "#/$defs/uuid"},
    "deployment_mode": {"const": "onpremise"},
    "delivery_kind": {"const": "connected"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "current_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "current_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "component_versions": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "version"],
        "properties": {
          "component": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"current_sequence": {"const": 0}}}, "then": {"properties": {"current_digest": {"type": "null"}}}},
    {"if": {"properties": {"current_sequence": {"minimum": 1}}}, "then": {"properties": {"current_digest": {"type": "string"}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
