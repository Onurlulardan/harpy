{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/license/v2/license-trust-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "purpose", "roots", "keysets"],
  "properties": {
    "schema": {"const": "harpy-license-trust-bundle.v1"},
    "purpose": {"const": "harpy-license-envelope.v2"},
    "roots": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/key"}},
    "keysets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/envelope"}}
  },
  "$defs": {
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["kid", "algorithm", "public_key", "status", "not_before", "sign_until", "verify_until"],
      "properties": {
        "kid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "algorithm": {"const": "Ed25519"},
        "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "status": {"enum": ["active", "verify_only", "revoked"]},
        "not_before": {"$ref": "#/$defs/instant"},
        "sign_until": {"$ref": "#/$defs/instant"},
        "verify_until": {"$ref": "#/$defs/instant"}
      }
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kid", "algorithm", "canonicalization", "payload_sha256", "payload", "signature"],
      "properties": {
        "schema": {"const": "harpy-license-keyset-envelope.v1"},
        "kid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "algorithm": {"const": "Ed25519"},
        "canonicalization": {"const": "RFC8785"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
        "payload": {"$ref": "#/$defs/keyset"}
      }
    },
    "keyset": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "issuer", "audience", "sequence", "issued_at", "not_before", "expires_at", "snapshot_signers"],
      "properties": {
        "schema": {"const": "harpy-license-online-keyset.v1"},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
        "audience": {"const": "harpy-license-snapshot"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "issued_at": {"$ref": "#/$defs/instant"},
        "not_before": {"$ref": "#/$defs/instant"},
        "expires_at": {"$ref": "#/$defs/instant"},
        "snapshot_signers": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/key"}}
      }
    }
  }
}
