{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.io/contracts/jobs/v1/job-enqueue.schema.json",
  "title": "Harpy Job Enqueue v1",
  "x-maxDocumentUtf8Bytes": 131072,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "job_id", "kind", "payload_revision", "tenant_id", "authority",
    "payload_reference", "payload_sha256", "run_at", "priority", "dedupe_key",
    "effect_idempotency_key", "maximum_attempts", "retry_of_job_id"
  ],
  "properties": {
    "contract_version": {"const": "job-enqueue.v1"},
    "job_id": {"$ref": "job-defs.schema.json#/$defs/uuid"},
    "kind": {"$ref": "job-defs.schema.json#/$defs/kind"},
    "payload_revision": {"type": "integer", "minimum": 1},
    "tenant_id": {"$ref": "job-defs.schema.json#/$defs/nullableUuid"},
    "authority": {"$ref": "job-defs.schema.json#/$defs/authority"},
    "payload_reference": {"$ref": "job-defs.schema.json#/$defs/reference"},
    "payload_sha256": {"$ref": "job-defs.schema.json#/$defs/sha256"},
    "run_at": {"$ref": "job-defs.schema.json#/$defs/timestamp"},
    "priority": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "dedupe_key": {"$ref": "job-defs.schema.json#/$defs/key"},
    "effect_idempotency_key": {"anyOf": [{"type": "null"}, {"$ref": "job-defs.schema.json#/$defs/key"}]},
    "maximum_attempts": {"type": "integer", "minimum": 1, "maximum": 25},
    "retry_of_job_id": {"$ref": "job-defs.schema.json#/$defs/nullableUuid"}
  },
  "oneOf": [
    {"properties": {
      "tenant_id": {"$ref": "job-defs.schema.json#/$defs/uuid"},
      "authority": {"properties": {"scope_kind": {"const": "tenant"}}}
    }},
    {"properties": {
      "tenant_id": {"type": "null"},
      "authority": {"properties": {"scope_kind": {"const": "global"}}}
    }}
  ]
}
