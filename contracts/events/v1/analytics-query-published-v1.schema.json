{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harpy://events/analytics-query-published-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "query_version_id", "root_revision", "manifest_sha256"],
  "properties": {
    "query_id": {"type": "string", "format": "uuid"},
    "query_version_id": {"type": "string", "format": "uuid"},
    "root_revision": {"type": "integer", "minimum": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
