{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harpy://events/forms-record-updated-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "after_sha256",
    "authority_kind",
    "before_sha256",
    "changed_field_ids",
    "form_id",
    "form_version_id",
    "operation",
    "publication_id",
    "receipt_id"
  ],
  "properties": {
    "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_kind": {"enum": ["actor", "workflow"]},
    "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changed_field_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    },
    "form_id": {"type": "string", "format": "uuid"},
    "form_version_id": {"type": "string", "format": "uuid"},
    "operation": {"const": "update"},
    "publication_id": {"type": "string", "format": "uuid"},
    "receipt_id": {"type": "string", "format": "uuid"}
  }
}
