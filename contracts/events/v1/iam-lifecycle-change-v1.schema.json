{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harpy://events/iam-lifecycle-change-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["aggregate_kind", "command", "revision"],
  "properties": {
    "aggregate_kind": {
      "enum": ["authenticator", "identifier", "one_time_token", "password_credential", "portal_binding", "session"]
    },
    "command": {
      "enum": [
        "iam.authenticator.retire",
        "iam.authenticator.suspend",
        "iam.email_verification.start",
        "iam.identifier.add",
        "iam.identifier.retire",
        "iam.identifier.tombstone",
        "iam.identifier.verify",
        "iam.password.change",
        "iam.password_reset.complete",
        "iam.password_reset.start",
        "iam.portal_approval.decide",
        "iam.portal_setup.complete",
        "iam.portal_setup.start",
        "iam.recovery_codes.issue",
        "iam.session.revoke_all",
        "iam.session.revoke_one",
        "iam.totp.enrollment.complete",
        "iam.totp.enrollment.start",
        "iam.webauthn.enrollment.complete",
        "iam.webauthn.enrollment.start"
      ]
    },
    "revision": {"type": "integer", "minimum": 1}
  }
}
