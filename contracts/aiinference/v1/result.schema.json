{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.internal/contracts/aiinference/v1/result.schema.json",
  "$ref": "#/$defs/GenerationResponse",
  "$defs": {
    "Usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cached_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "cached_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    },
    "UsageReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "algorithm", "signing_key_id",
        "signing_key_revision", "receipt", "signature"],
      "properties": {
        "contract_version": {"const": "ai-inference-signed-receipt.v1"},
        "algorithm": {"const": "hmac-sha256"},
        "signing_key_id": {"const": "ai-core-service-v1"},
        "signing_key_revision": {"const": 1},
        "signature": {"type": "string", "minLength": 43, "maxLength": 43},
        "receipt": {
          "type": "object", "additionalProperties": false,
          "required": ["contract_version", "receipt_id", "invocation_id", "request_hash",
            "provider", "resolved_model", "usage", "finish_class", "duration_ms", "issued_at"],
          "properties": {
            "contract_version": {"const": "ai-inference-usage-receipt.v1"},
            "receipt_id": {"type": "string", "format": "uuid"},
            "invocation_id": {"type": "string", "format": "uuid"},
            "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "provider": {"type": "string"},
            "resolved_model": {"type": "string"},
            "usage": {"$ref": "#/$defs/Usage"},
            "finish_class": {"enum": ["stop", "length", "tool_proposals", "content_filter", "embedding"]},
            "duration_ms": {"type": "integer", "minimum": 0, "maximum": 121000},
            "provider_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "issued_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "GenerationResult": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "invocation_id", "request_hash", "provider",
        "resolved_model", "content", "tool_proposals", "finish_class", "usage_receipt"],
      "properties": {
        "contract_version": {"const": "ai-inference-result.v1"},
        "invocation_id": {"type": "string", "format": "uuid"},
        "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider": {"type": "string"},
        "resolved_model": {"type": "string"},
        "content": {"type": "string", "maxLength": 1048576},
        "tool_proposals": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
        "finish_class": {"enum": ["stop", "length", "tool_proposals", "content_filter"]},
        "usage_receipt": {"$ref": "#/$defs/UsageReceipt"}
      }
    },
    "GenerationResponse": {
      "type": "object", "additionalProperties": false, "required": ["success", "data"],
      "properties": {"success": {"const": true}, "data": {"$ref": "#/$defs/GenerationResult"}}
    },
    "EmbeddingResult": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "invocation_id", "request_hash", "provider",
        "resolved_model", "dimensions", "vectors", "usage_receipt"],
      "properties": {
        "contract_version": {"const": "ai-inference-result.v1"},
        "invocation_id": {"type": "string", "format": "uuid"},
        "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider": {"type": "string"},
        "resolved_model": {"type": "string"},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 8192},
        "vectors": {"type": "array", "minItems": 1, "maxItems": 128,
          "items": {"type": "array", "minItems": 1, "maxItems": 8192,
            "items": {"type": "number"}}},
        "usage_receipt": {"$ref": "#/$defs/UsageReceipt"}
      }
    },
    "EmbeddingResponse": {
      "type": "object", "additionalProperties": false, "required": ["success", "data"],
      "properties": {"success": {"const": true}, "data": {"$ref": "#/$defs/EmbeddingResult"}}
    }
  }
}
