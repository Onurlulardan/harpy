{
  "openapi": "3.1.0",
  "info": {"title": "Harpy AI Inference Boundary", "version": "1.0.0"},
  "servers": [{"url": "https://ai-provider.internal"}],
  "paths": {
    "/internal/ai/v1/generate": {
      "post": {
        "operationId": "generateAI",
        "security": [{"coreServiceCredential": []}],
        "parameters": [
          {"$ref": "#/components/parameters/ServiceAudience"},
          {"$ref": "#/components/parameters/ContractVersion"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {
          "schema": {"$ref": "request.schema.json"}
        }}},
        "responses": {
          "200": {"description": "Sanitized generation and signed usage receipt", "content": {
            "application/json": {"schema": {"$ref": "result.schema.json"}}
          }},
          "400": {"description": "Invalid request or unsupported capability"},
          "401": {"description": "Service credential rejected"},
          "403": {"description": "Signed current context rejected"},
          "413": {"description": "Request exceeds the one MiB boundary"},
          "502": {"description": "Provider rejected or returned an invalid protocol response"},
          "504": {"description": "Hard provider deadline exceeded"}
        }
      }
    },
    "/internal/ai/v1/generate/stream": {
      "post": {
        "operationId": "streamAI",
        "security": [{"coreServiceCredential": []}],
        "parameters": [
          {"$ref": "#/components/parameters/ServiceAudience"},
          {"$ref": "#/components/parameters/ContractVersion"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {
          "schema": {"$ref": "request.schema.json"}
        }}},
        "responses": {
          "200": {"description": "Versioned SSE ending in one terminal event and data DONE", "content": {
            "text/event-stream": {"schema": {"type": "string"}}
          }},
          "400": {"description": "Invalid request or unsupported capability"},
          "401": {"description": "Service credential rejected"},
          "403": {"description": "Signed current context rejected"},
          "413": {"description": "Request exceeds the one MiB boundary"}
        }
      }
    },
    "/internal/ai/v1/embed": {
      "post": {
        "operationId": "embedAI",
        "security": [{"coreServiceCredential": []}],
        "parameters": [
          {"$ref": "#/components/parameters/ServiceAudience"},
          {"$ref": "#/components/parameters/ContractVersion"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {
          "schema": {"$ref": "request.schema.json#/$defs/EmbeddingRequest"}
        }}},
        "responses": {
          "200": {"description": "Finite ordered vectors and signed usage receipt", "content": {
            "application/json": {"schema": {"$ref": "result.schema.json#/$defs/EmbeddingResponse"}}
          }},
          "400": {"description": "Invalid request or unsupported capability"},
          "401": {"description": "Service credential rejected"},
          "403": {"description": "Signed current context rejected"},
          "413": {"description": "Request exceeds the one MiB boundary"},
          "502": {"description": "Provider rejected or returned invalid vectors"},
          "504": {"description": "Hard provider deadline exceeded"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "coreServiceCredential": {"type": "http", "scheme": "bearer",
        "description": "Audience-bound Core service credential; client bearer tokens are forbidden."}
    },
    "parameters": {
      "ServiceAudience": {"name": "X-Harpy-Service-Audience", "in": "header",
        "required": true, "schema": {"const": "harpy-ai-provider-v1"}},
      "ContractVersion": {"name": "X-Harpy-Contract-Version", "in": "header",
        "required": true, "schema": {"const": "core-ai-inference.v1"}}
    }
  }
}
