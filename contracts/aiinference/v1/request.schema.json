{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpy.internal/contracts/aiinference/v1/request.schema.json",
  "$ref": "#/$defs/GenerationRequest",
  "$defs": {
    "Binding": {
      "type": "object",
      "required": ["contract_version", "invocation_id", "receipt_id", "request_hash",
        "tenant_id", "config_id", "config_revision", "credential_revision",
        "authorization_version", "operation", "provider", "model", "signed_context"],
      "properties": {
        "contract_version": {"const": "core-ai-inference.v1"},
        "invocation_id": {"type": "string", "format": "uuid"},
        "receipt_id": {"type": "string", "format": "uuid"},
        "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "config_id": {"type": "string", "format": "uuid"},
        "config_revision": {"type": "integer", "minimum": 1},
        "credential_revision": {"type": "integer", "minimum": 0},
        "authorization_version": {"type": "integer", "minimum": 1},
        "operation": {"enum": ["ai.inference.generate", "ai.inference.generate.stream", "ai.inference.embed"]},
        "provider": {"enum": ["openai", "anthropic", "gemini", "ollama", "custom"]},
        "base_url": {"type": "string", "maxLength": 2048},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "credential_envelope": {"type": "object"},
        "signed_context": {"type": "object"}
      }
    },
    "ToolProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "name", "arguments"],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^tool_[a-z0-9_]{1,58}$"},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "arguments": {"type": "object"}
      }
    },
    "Message": {
      "type": "object", "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant", "tool"]},
        "content": {"type": "string", "maxLength": 262144},
        "tool_proposals": {"type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/ToolProposal"}},
        "tool_result": {
          "type": "object", "additionalProperties": false,
          "required": ["proposal_id", "name", "content", "is_error"],
          "properties": {
            "proposal_id": {"type": "string"}, "name": {"type": "string"},
            "content": {"type": "string", "maxLength": 262144}, "is_error": {"type": "boolean"}
          }
        }
      }
    },
    "ToolDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "input_schema"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "description": {"type": "string", "maxLength": 4096},
        "input_schema": {"type": "object"}
      }
    },
    "GenerationRequest": {
      "allOf": [
        {"$ref": "#/$defs/Binding"},
        {"type": "object", "required": ["messages", "settings"], "properties": {
          "messages": {"type": "array", "minItems": 1, "maxItems": 256,
            "items": {"$ref": "#/$defs/Message"}},
          "tools": {"type": "array", "maxItems": 64,
            "items": {"$ref": "#/$defs/ToolDefinition"}},
          "settings": {
            "type": "object", "additionalProperties": false,
            "required": ["maximum_output_tokens", "timeout_ms"],
            "properties": {
              "maximum_output_tokens": {"type": "integer", "minimum": 1, "maximum": 32768},
              "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 120000},
              "temperature": {"type": "number", "minimum": 0, "maximum": 2}
            }
          }
        }}
      ],
      "unevaluatedProperties": false
    },
    "EmbeddingRequest": {
      "allOf": [
        {"$ref": "#/$defs/Binding"},
        {"type": "object", "required": ["inputs", "timeout_ms"], "properties": {
          "inputs": {"type": "array", "minItems": 1, "maxItems": 128,
            "items": {"type": "string", "minLength": 1, "maxLength": 262144}},
          "dimensions": {"type": "integer", "minimum": 0, "maximum": 8192},
          "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 120000}
        }}
      ],
      "unevaluatedProperties": false
    }
  }
}
